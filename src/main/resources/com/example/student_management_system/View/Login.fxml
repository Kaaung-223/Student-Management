<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1100.0"
           style="-fx-background-color: #f8fafc;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.LoginController">

    <AnchorPane>
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- LEFT BRAND AREA (updated logo) -->
            <StackPane minWidth="460.0" prefWidth="500.0"
                       style="-fx-background-color: linear-gradient(to bottom right, #1e1b4b, #312e81, #4f46e5);"
                       HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER_LEFT" maxWidth="350" spacing="22">
                    <padding>
                        <Insets bottom="55" left="55" right="55" top="55"/>
                    </padding>

                    <!-- New logo: circular monogram + text -->
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <StackPane minHeight="50" minWidth="50" prefHeight="50" prefWidth="50"
                                   style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 50; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 50; -fx-border-width: 1.5;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"
                                   text="SH"/>
                        </StackPane>

                        <VBox spacing="1">
                            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                                   text="StudentHub"/>
                            <Label style="-fx-text-fill: #a5b4fc; -fx-font-size: 10px; -fx-font-weight: bold;"
                                   text="MANAGEMENT SYSTEM"/>
                        </VBox>
                    </HBox>

                    <Region prefHeight="24"/>

                    <VBox spacing="12">
                        <Label maxWidth="330"
                               style="-fx-text-fill: white; -fx-font-size: 29px; -fx-font-weight: bold;"
                               text="Manage your school with confidence."
                               wrapText="true"/>

                        <Label maxWidth="325"
                               style="-fx-text-fill: #c7d2fe; -fx-font-size: 14px; -fx-line-spacing: 3;"
                               text="A simple workspace for students, teachers, attendance, exams and results."
                               wrapText="true"/>
                    </VBox>

                    <Region prefHeight="20"/>

                    <VBox spacing="13"
                          style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 16; -fx-padding: 18;">
                        <HBox alignment="CENTER_LEFT" spacing="11">
                            <StackPane minHeight="26" minWidth="26"
                                       style="-fx-background-color: rgba(255,255,255,0.18); -fx-background-radius: 13;">
                                <Label style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;" text="01"/>
                            </StackPane>
                            <Label style="-fx-text-fill: #eef2ff; -fx-font-size: 12px;" text="Manage students and classes"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="11">
                            <StackPane minHeight="26" minWidth="26"
                                       style="-fx-background-color: rgba(255,255,255,0.18); -fx-background-radius: 13;">
                                <Label style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;" text="02"/>
                            </StackPane>
                            <Label style="-fx-text-fill: #eef2ff; -fx-font-size: 12px;" text="Track attendance and progress"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="11">
                            <StackPane minHeight="26" minWidth="26"
                                       style="-fx-background-color: rgba(255,255,255,0.18); -fx-background-radius: 13;">
                                <Label style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;" text="03"/>
                            </StackPane>
                            <Label style="-fx-text-fill: #eef2ff; -fx-font-size: 12px;" text="View exam results instantly"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>

            <!-- RIGHT LOGIN AREA -->
            <StackPane style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER_LEFT" maxWidth="385" prefWidth="385" spacing="18">

                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #0f172a; -fx-font-size: 25px; -fx-font-weight: bold;"
                               text="Sign in"/>

                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                               text="Enter your details to continue."/>
                    </VBox>

                    <VBox spacing="7">
                        <Label style="-fx-text-fill: #334155; -fx-font-size: 11px; -fx-font-weight: bold;"
                               text="USERNAME"/>

                        <TextField fx:id="txtUsername" prefHeight="46" promptText="Enter your username"
                                   style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dbe1ea; -fx-border-radius: 10; -fx-font-size: 13px; -fx-padding: 0 14;"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label style="-fx-text-fill: #334155; -fx-font-size: 11px; -fx-font-weight: bold;"
                               text="PASSWORD"/>

                        <HBox alignment="CENTER_LEFT" prefHeight="46"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dbe1ea; -fx-border-radius: 10;">

                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField" promptText="Enter your password"
                                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 0 14;"/>

                                <TextField fx:id="visiblePasswordField" managed="false" promptText="Enter your password"
                                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 0 14;"
                                           visible="false"/>
                            </StackPane>

                            <!-- Eye toggle (Label with icon) -->
                            <StackPane fx:id="eyeToggle" minHeight="34" minWidth="34"
                                       style="-fx-background-color: #eef2ff; -fx-background-radius: 8; -fx-cursor: hand;"
                                       onMouseClicked="#togglePassword">
                                <Label fx:id="eyeLabel" style="-fx-text-fill: #4f46e5; -fx-font-size: 18px; -fx-font-weight: bold;"
                                       text="👁"/>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT">
                        <CheckBox text="Remember me"
                                  style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Hyperlink style="-fx-text-fill: #4f46e5; -fx-font-size: 12px; -fx-font-weight: bold;"
                                   text="Forgot password?"/>
                    </HBox>

                    <Button fx:id="btnLogin" maxWidth="Infinity" minHeight="47"
                            onAction="#login"
                            onMousePressed="#handleLoginPress"
                            onMouseReleased="#handleLoginRelease"
                            style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"
                            text="SIGN IN"/>

                    <Label maxWidth="Infinity"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-alignment: CENTER;"
                           text="StudentHub secure access"/>
                </VBox>
            </StackPane>
        </HBox>
    </AnchorPane>

    <!-- MODERN WELCOME CARD (glassmorphism style) -->
    <StackPane fx:id="messageOverlay" managed="false" visible="false"
               style="-fx-background-color: rgba(15,23,42,0.45);">

        <VBox alignment="CENTER" maxWidth="380" prefWidth="380" spacing="8"
              style="-fx-background-color: rgba(255,255,255,0.90); -fx-background-radius: 24; -fx-padding: 30 24 24 24; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.25), 30, 0, 0, 8);">

            <!-- Welcome icon (hand wave) -->
            <StackPane minHeight="60" minWidth="60"
                       style="-fx-background-color: #e0e7ff; -fx-background-radius: 30;">
                <Label style="-fx-font-size: 32px;" text="👋"/>
            </StackPane>

            <!-- Greeting message -->
            <Label fx:id="lblWelcomeMessage"
                   style="-fx-text-fill: #0f172a; -fx-font-size: 22px; -fx-font-weight: 700; -fx-alignment: CENTER;"
                   text="Welcome back, Admin!"
                   wrapText="true"/>

            <!-- Optional sub-text (static, can be changed if needed) -->
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-alignment: CENTER;"
                   text="You are signed in to your account."
                   wrapText="true"/>

            <!-- Action button -->
            <Button fx:id="btnMessageAction" maxWidth="Infinity" minHeight="42"
                    onAction="#handleMessageAction"
                    style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Go to Dashboard"/>
        </VBox>
    </StackPane>
</StackPane>
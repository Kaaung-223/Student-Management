<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="950.0" style="-fx-background-color: linear-gradient(to right,#5145FF,#2F67F4);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.student_management_system.Controller.LoginController">

    <children>

        <StackPane layoutY="102.0" prefHeight="596.0" prefWidth="940.0" AnchorPane.bottomAnchor="102.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="10.399999999999977" AnchorPane.topAnchor="102.0">

            <VBox alignment="CENTER" maxWidth="420" minHeight="-Infinity" minWidth="184.0" prefHeight="506.0" prefWidth="374.0" spacing="20" style="-fx-background-color:white;                          -fx-background-radius:20;                          -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.25),15,0,0,5);">

                <padding>
                    <Insets bottom="35" left="35" right="35" top="35" />
                </padding>

                <!-- Logo -->

                <Label text="🎓">
                    <font>
                        <Font size="60" />
                    </font>
                </Label>

                <Label style="-fx-font-size:24;                               -fx-font-weight:bold;                               -fx-text-fill:#1E3A8A;" text="Student Management System" />

                <Label style="-fx-text-fill:#6B7280;" text="Login to continue" />

                <!-- Username -->

                <HBox alignment="CENTER_LEFT" prefHeight="45" spacing="10" style="-fx-background-color:#F8FAFC;                              -fx-background-radius:10;                              -fx-border-color:#D1D5DB;                              -fx-border-radius:10;">

                    <padding>
                        <Insets left="12" right="12" />
                    </padding>

                    <Label style="-fx-font-size:18;" text="👤" />

                    <TextField fx:id="txtUsername" promptText="Username" style="-fx-background-color:transparent;                                       -fx-border-color:transparent;                                       -fx-font-size:14;" HBox.hgrow="ALWAYS" />

                </HBox>

                <!-- Password -->

                <HBox alignment="CENTER_LEFT" prefHeight="45" spacing="10" style="-fx-background-color:#F8FAFC;                              -fx-background-radius:10;                              -fx-border-color:#D1D5DB;                              -fx-border-radius:10;">

                    <padding>
                        <Insets left="12" right="12" />
                    </padding>

                    <Label style="-fx-font-size:18;" text="🔒" />

                    <StackPane HBox.hgrow="ALWAYS">

                        <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-color:transparent;                                               -fx-border-color:transparent;                                               -fx-font-size:14;" />

                        <TextField fx:id="visiblePasswordField" managed="false" promptText="Password" style="-fx-background-color:transparent;                                           -fx-border-color:transparent;                                           -fx-font-size:14;" visible="false" />

                    </StackPane>

                    <Button fx:id="btnEye" onAction="#togglePassword" style="-fx-background-color:transparent;                                    -fx-font-size:16;                                    -fx-cursor:hand;" text="👁" />

                </HBox>

                <CheckBox text="Remember Me" />

                <!-- Login button – now with mouse handlers for press effect -->
                <Button fx:id="btnLogin"
                        onAction="#login"
                        onMousePressed="#handleLoginPress"
                        onMouseReleased="#handleLoginRelease"
                        prefHeight="45"
                        prefWidth="320"
                        style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-background-radius:10; -fx-font-size:16; -fx-font-weight:bold;"
                        text="LOGIN" />

                <Hyperlink text="Forgot Password?" />

            </VBox>

        </StackPane>

    </children>

</AnchorPane>
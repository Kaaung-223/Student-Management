<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="720" prefWidth="1100"
           style="-fx-background-color:#f8fafc;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.LoginController">

    <AnchorPane>
        <HBox AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <!-- LEFT SIDE -->
            <StackPane minWidth="460"
                       prefWidth="500"
                       style="-fx-background-color:linear-gradient(to bottom right,#1e1b4b,#312e81,#4f46e5);"
                       HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER_LEFT"
                      maxWidth="350"
                      spacing="22">

                    <padding>
                        <Insets top="55" right="55" bottom="55" left="55"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="14">

                        <StackPane minHeight="50"
                                   minWidth="50"
                                   style="-fx-background-color:rgba(255,255,255,.15);-fx-background-radius:50;-fx-border-color:rgba(255,255,255,.3);-fx-border-radius:50;">

                            <Label style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"
                                   text="SH"/>
                        </StackPane>

                        <VBox spacing="1">
                            <Label style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"
                                   text="StudentHub"/>

                            <Label style="-fx-text-fill:#a5b4fc;-fx-font-size:10px;-fx-font-weight:bold;"
                                   text="MANAGEMENT SYSTEM"/>
                        </VBox>

                    </HBox>

                    <Region prefHeight="25"/>

                    <VBox spacing="12">

                        <Label maxWidth="335"
                               style="-fx-text-fill:white;-fx-font-size:29px;-fx-font-weight:bold;"
                               text="Manage your school with confidence."
                               wrapText="true"/>

                        <Label maxWidth="325"
                               style="-fx-text-fill:#c7d2fe;-fx-font-size:14px;"
                               text="A simple workspace for students, teachers, attendance, exams and results."
                               wrapText="true"/>

                    </VBox>

                    <Region prefHeight="18"/>

                    <VBox spacing="13"
                          style="-fx-background-color:rgba(255,255,255,.1);-fx-background-radius:16;-fx-padding:18;">

                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:bold;"
                               text="SMART. SIMPLE. SECURE."/>

                        <Label style="-fx-text-fill:#c7d2fe;-fx-font-size:12px;"
                               text="Your complete school management workspace."/>

                    </VBox>

                </VBox>

            </StackPane>


            <!-- RIGHT SIDE -->
            <StackPane style="-fx-background-color:#f8fafc;"
                       HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER_LEFT"
                      maxWidth="385"
                      prefWidth="385"
                      spacing="18">

                    <VBox spacing="5">

                        <Label style="-fx-text-fill:#0f172a;-fx-font-size:25px;-fx-font-weight:bold;"
                               text="Welcome back"/>

                        <Label style="-fx-text-fill:#64748b;-fx-font-size:13px;"
                               text="Sign in to continue to your dashboard."/>

                    </VBox>


                    <!-- USERNAME -->
                    <VBox spacing="7">

                        <Label style="-fx-text-fill:#334155;-fx-font-size:11px;-fx-font-weight:bold;"
                               text="USERNAME"/>

                        <TextField fx:id="txtUsername"
                                   prefHeight="46"
                                   promptText="Enter your username"
                                   style="-fx-background-color:white;-fx-background-radius:10;-fx-border-color:#dbe1ea;-fx-border-radius:10;-fx-font-size:13px;-fx-padding:0 14;"/>

                    </VBox>


                    <!-- PASSWORD -->
                    <VBox spacing="7">

                        <Label style="-fx-text-fill:#334155;-fx-font-size:11px;-fx-font-weight:bold;"
                               text="PASSWORD"/>

                        <HBox alignment="CENTER_LEFT"
                              prefHeight="46"
                              style="-fx-background-color:white;-fx-background-radius:10;-fx-border-color:#dbe1ea;-fx-border-radius:10;">

                            <StackPane HBox.hgrow="ALWAYS">

                                <PasswordField fx:id="passwordField"
                                               promptText="Enter your password"
                                               style="-fx-background-color:transparent;
                                  -fx-border-color:transparent;
                                  -fx-font-size:13px;
                                  -fx-padding:0 14;"/>

                                <TextField fx:id="visiblePasswordField"
                                           managed="false"
                                           visible="false"
                                           promptText="Enter your password"
                                           style="-fx-background-color:transparent;
                              -fx-border-color:transparent;
                              -fx-font-size:13px;
                              -fx-padding:0 14;"/>

                            </StackPane>

                            <Button fx:id="btnEye"
                                    minWidth="40"
                                    minHeight="40"
                                    onAction="#togglePassword"
                                    style="-fx-background-color:transparent;
                       -fx-border-color:transparent;
                       -fx-padding:0;
                       -fx-cursor:hand;">

                                <graphic>
                                    <FontIcon fx:id="eyeIcon"
                                              iconLiteral="fas-eye"
                                              iconSize="16"
                                              iconColor="#64748b"/>
                                </graphic>

                            </Button>

                        </HBox>

                    </VBox>


                    <!-- REMEMBER / FORGOT -->
                    <HBox alignment="CENTER_LEFT">

                        <CheckBox text="Remember me"
                                  style="-fx-text-fill:#64748b;-fx-font-size:12px;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Hyperlink style="-fx-text-fill:#4f46e5;-fx-font-size:12px;-fx-font-weight:bold;"
                                   text="Forgot password?"/>

                    </HBox>


                    <!-- LOGIN BUTTON -->
                    <Button fx:id="btnLogin"
                            maxWidth="Infinity"
                            minHeight="47"
                            defaultButton="true"
                            onAction="#login"
                            onMousePressed="#handleLoginPress"
                            onMouseReleased="#handleLoginRelease"
                            style="-fx-background-color:#4f46e5;
               -fx-text-fill:white;
               -fx-background-radius:10;
               -fx-font-size:13px;
               -fx-font-weight:bold;
               -fx-cursor:hand;"
                            text="SIGN IN"/>


                    <Label maxWidth="Infinity"
                           style="-fx-text-fill:#94a3b8;-fx-font-size:10px;-fx-alignment:CENTER;"
                           text="StudentHub secure access"/>

                </VBox>

            </StackPane>

        </HBox>

    </AnchorPane>


    <!-- LOGIN MESSAGE TOAST (same style as admin dashboard welcome toast) -->
    <VBox fx:id="loginToast"
          managed="false"
          visible="false"
          maxWidth="350"
          prefWidth="350"
          spacing="8"
          StackPane.alignment="TOP_RIGHT"
          translateX="-24"
          translateY="24"
          style="-fx-background-color:white;
                 -fx-background-radius:15;
                 -fx-padding:15 17 15 15;
                 -fx-border-color:#e2e8f0;
                 -fx-border-radius:15;
                 -fx-effect:dropshadow(gaussian,rgba(15,23,42,.20),22,0,0,6);">

        <HBox spacing="12"
              alignment="CENTER_LEFT">

            <StackPane fx:id="loginToastIconWrap"
                       minHeight="38"
                       minWidth="38"
                       style="-fx-background-color:#fee2e2;
                              -fx-background-radius:19;">

                <Label fx:id="loginToastIcon"
                       style="-fx-text-fill:#dc2626;
                              -fx-font-size:17px;
                              -fx-font-weight:bold;"
                       text="✕"/>

            </StackPane>

            <VBox spacing="3"
                  HBox.hgrow="ALWAYS">

                <Label fx:id="lblLoginToastTitle"
                       style="-fx-text-fill:#64748b;
                              -fx-font-size:9px;
                              -fx-font-weight:bold;"
                       text="LOGIN FAILED"/>

                <Label fx:id="lblLoginToastHeading"
                       style="-fx-text-fill:#0f172a;
                              -fx-font-size:14px;
                              -fx-font-weight:bold;"
                       text="Invalid login"/>

                <Label fx:id="lblLoginToastMessage"
                       wrapText="true"
                       maxWidth="260"
                       style="-fx-text-fill:#64748b;
                              -fx-font-size:11px;"
                       text="Check your username and password."/>

            </VBox>

        </HBox>

        <Region fx:id="loginToastAccent"
                minHeight="3"
                maxHeight="3"
                style="-fx-background-color:#ef4444;
                       -fx-background-radius:3;"/>

    </VBox>

</StackPane>

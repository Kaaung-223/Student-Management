<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.Teacher.TeacherExamController"
           style="-fx-background-color:#f6f8fc;">

    <AnchorPane>
        <VBox spacing="20"
              AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <padding><Insets top="28" right="30" bottom="30" left="30"/></padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="Exams"
                           style="-fx-text-fill:#0f172a;-fx-font-size:28px;-fx-font-weight:bold;"/>
                    <Label text="Create exams and enter marks for your students."
                           style="-fx-text-fill:#64748b;-fx-font-size:13px;"/>
                </VBox>
                <Label fx:id="lblExamCount" text="0 exams"
                       style="-fx-text-fill:#4f46e5;-fx-background-color:#eef2ff;-fx-background-radius:12;-fx-padding:8 12;-fx-font-size:11px;-fx-font-weight:bold;"/>
            </HBox>

            <!-- FILTER BAR -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:16;-fx-border-color:#e8edf5;-fx-border-radius:16;">

                <VBox spacing="5">
                    <Label text="BATCH"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                    <ComboBox fx:id="cmbBatch" prefWidth="220" prefHeight="38" promptText="All Batches"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="SUBJECT"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                    <ComboBox fx:id="cmbSubject" prefWidth="220" prefHeight="38" promptText="Select Subject"/>
                </VBox>

                <VBox spacing="5">
                    <Label text=" " style="-fx-font-size:10px;"/>
                    <Button onAction="#refreshExams" minHeight="38"
                            style="-fx-background-color:#4f46e5;-fx-text-fill:white;-fx-background-radius:9;-fx-font-size:11px;-fx-font-weight:bold;-fx-padding:0 18;"
                            text="Refresh"/>
                </VBox>
            </HBox>

            <!-- MAIN -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">

                <!-- LEFT — create form + exam list -->
                <VBox prefWidth="500" minWidth="440" spacing="16">

                    <VBox spacing="10"
                          style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;">

                        <VBox spacing="3">
                            <Label text="Create New Exam"
                                   style="-fx-text-fill:#0f172a;-fx-font-size:16px;-fx-font-weight:bold;"/>
                            <Label text="Fill in the details and click Create."
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                        </VBox>

                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="EXAM NAME"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                                <TextField fx:id="txtExamName" prefHeight="36"
                                           promptText="e.g. Midterm 2026"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="DATE"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                                <DatePicker fx:id="dpExamDate" prefWidth="150" prefHeight="36"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="TOTAL MARKS"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                                <TextField fx:id="txtTotalMarks" prefHeight="36"
                                           promptText="e.g. 100"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="BATCH"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                                <ComboBox fx:id="cmbCreateBatch" prefHeight="36"
                                          maxWidth="Infinity" promptText="Select batch"/>
                            </VBox>
                        </HBox>

                        <Button onAction="#createExam"
                                prefHeight="44" maxWidth="Infinity"
                                style="-fx-background-color:linear-gradient(to right,#4f46e5,#6366f1);
                                       -fx-text-fill:white;
                                       -fx-background-radius:10;
                                       -fx-font-size:13px;
                                       -fx-font-weight:bold;
                                       -fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(79,70,229,.35),10,0,0,3);"
                                text="＋  Create Exam"/>
                    </VBox>

                    <VBox spacing="10" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;">

                        <VBox spacing="3">
                            <Label text="Existing Exams"
                                   style="-fx-text-fill:#0f172a;-fx-font-size:16px;-fx-font-weight:bold;"/>
                            <Label text="Select an exam to enter marks."
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                        </VBox>

                        <TableView fx:id="examTable" prefHeight="260" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color:white;-fx-border-color:#e2e8f0;-fx-border-radius:10;-fx-background-radius:10;">
                            <columns>
                                <TableColumn fx:id="colExamName"  prefWidth="180" text="Exam"/>
                                <TableColumn fx:id="colExamBatch" prefWidth="140" text="Batch"/>
                                <TableColumn fx:id="colExamTotal" prefWidth="70"  text="Total"/>
                                <TableColumn fx:id="colExamDate"  prefWidth="100" text="Date"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- RIGHT — marks entry -->
                <VBox spacing="14" VBox.vgrow="ALWAYS"
                      style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;"
                      HBox.hgrow="ALWAYS">

                    <HBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3">
                            <Label text="Enter Marks"
                                   style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblMarksSubtitle" text="Select an exam to begin."
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                        </VBox>
                        <Label fx:id="lblMarkedCount" text="0 / 0 marked"
                               style="-fx-text-fill:#4f46e5;-fx-background-color:#eef2ff;-fx-background-radius:12;-fx-padding:8 12;-fx-font-size:11px;-fx-font-weight:bold;"/>
                    </HBox>

                    <TableView fx:id="marksTable" prefHeight="500" VBox.vgrow="ALWAYS"
                               style="-fx-background-color:white;-fx-border-color:#e2e8f0;-fx-border-radius:10;-fx-background-radius:10;">
                        <columns>
                            <TableColumn fx:id="colCode"    prefWidth="100" text="Code"/>
                            <TableColumn fx:id="colName"    prefWidth="200" text="Student"/>
                            <TableColumn fx:id="colMarks"   prefWidth="110" text="Marks"/>
                            <TableColumn fx:id="colRemarks" prefWidth="280" text="Remarks"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12" alignment="CENTER_RIGHT"
                          style="-fx-padding:4 0 0 0;">

                        <Button onAction="#markAllFull"
                                prefHeight="42" minWidth="150"
                                style="-fx-background-color:#eef2ff;
                                       -fx-text-fill:#4f46e5;
                                       -fx-background-radius:10;
                                       -fx-font-size:12px;
                                       -fx-font-weight:bold;
                                       -fx-padding:0 22;
                                       -fx-cursor:hand;
                                       -fx-border-color:#c7d2fe;
                                       -fx-border-radius:10;"
                                text="✓  Mark All Full"/>

                        <Button onAction="#saveMarks"
                                prefHeight="42" minWidth="160"
                                style="-fx-background-color:linear-gradient(to right,#4f46e5,#6366f1);
                                       -fx-text-fill:white;
                                       -fx-background-radius:10;
                                       -fx-font-size:12px;
                                       -fx-font-weight:bold;
                                       -fx-padding:0 26;
                                       -fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(79,70,229,.35),10,0,0,3);"
                                text="Save Marks"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </AnchorPane>

    <!-- TOAST -->
    <VBox fx:id="examToast" managed="false" visible="false"
          maxWidth="420" prefWidth="420" spacing="8"
          translateX="-24" translateY="24" StackPane.alignment="TOP_RIGHT"
          style="-fx-background-color:white; -fx-background-radius:15;
                 -fx-padding:15 17 15 15; -fx-border-color:#e2e8f0; -fx-border-radius:15;
                 -fx-effect:dropshadow(gaussian,rgba(15,23,42,.20),22,0,0,6);">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="toast-icon" minHeight="38" minWidth="38"
                       style="-fx-background-color:#dcfce7; -fx-background-radius:19;">
                <Label styleClass="toast-icon-label" text="✓"
                       style="-fx-text-fill:#16a34a; -fx-font-size:17px; -fx-font-weight:bold;"/>
            </StackPane>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label fx:id="lblToastTitle" text="SAVE SUCCESSFUL"
                       style="-fx-text-fill:#64748b;-fx-font-size:9px;-fx-font-weight:bold;"/>
                <Label fx:id="lblToastHeading" text="Marks saved"
                       style="-fx-text-fill:#0f172a;-fx-font-size:14px;-fx-font-weight:bold;"/>
                <Label fx:id="lblToastMessage" text="Saved successfully." wrapText="true"
                       style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>
            </VBox>
        </HBox>
        <Region styleClass="toast-bar" maxHeight="3" minHeight="3"
                style="-fx-background-color:#22c55e; -fx-background-radius:3;"/>
    </VBox>

</StackPane>
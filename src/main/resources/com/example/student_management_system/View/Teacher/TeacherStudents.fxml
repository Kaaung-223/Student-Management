<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color:#f6f8fc;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.student_management_system.Controller.Teacher.TeacherStudentsController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14">
        <Region minHeight="34" minWidth="6"
                style="-fx-background-color:linear-gradient(to bottom,#4f46e5,#6366f1); -fx-background-radius:8;"/>
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="My Students"
                   style="-fx-text-fill:#0f172a; -fx-font-size:26px; -fx-font-weight:bold;"/>
            <Label text="Browse and inspect students in your classes"
                   style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
        </VBox>
    </HBox>

    <!-- MAIN -->
    <GridPane hgap="18" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="58"/>
            <ColumnConstraints percentWidth="42"/>
        </columnConstraints>

        <!-- LEFT: filters + table -->
        <VBox spacing="14" GridPane.columnIndex="0"
              style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;
                     -fx-border-color:#e9edf5; -fx-border-radius:16;
                     -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),12,0,0,3);">

            <HBox spacing="10">
                <TextField fx:id="txtSearch" promptText="Search by name, code or email..."
                           HBox.hgrow="ALWAYS" prefHeight="38"
                           style="-fx-background-color:#f8fafc; -fx-background-radius:10;
                                  -fx-border-color:#e2e8f0; -fx-border-radius:10;
                                  -fx-padding:0 12;"/>
                <ComboBox fx:id="cmbBatch" prefHeight="38" prefWidth="190" promptText="Batch"/>
            </HBox>

            <Label fx:id="lblStudentCount" text="0 student(s)"
                   style="-fx-text-fill:#64748b; -fx-font-size:11px; -fx-font-weight:bold;"/>

            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS" prefHeight="520"
                       style="-fx-background-color:transparent; -fx-border-color:transparent;">
                <columns>
                    <TableColumn fx:id="colCode"   prefWidth="90"  text="Code"/>
                    <TableColumn fx:id="colName"   prefWidth="170" text="Name"/>
                    <TableColumn fx:id="colBatch"  prefWidth="160" text="Batch"/>
                    <TableColumn fx:id="colEmail"  prefWidth="200" text="Email"/>
                    <TableColumn fx:id="colStatus" prefWidth="90"  text="Status"/>
                </columns>
            </TableView>
        </VBox>

        <!-- RIGHT: profile + activity + performance -->
        <VBox spacing="14" GridPane.columnIndex="1">

            <VBox spacing="12"
                  style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;
                         -fx-border-color:#e9edf5; -fx-border-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),12,0,0,3);">

                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane minHeight="58" minWidth="58" prefHeight="58" prefWidth="58"
                               style="-fx-background-color:#eef2ff; -fx-background-radius:29;">
                        <Label fx:id="lblAvatar" text="--"
                               style="-fx-text-fill:#4f46e5; -fx-font-size:20px; -fx-font-weight:bold;"/>
                    </StackPane>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblStudentName" text="No student selected"
                               style="-fx-text-fill:#0f172a; -fx-font-size:17px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblStudentCode" text="Student profile"
                               style="-fx-text-fill:#64748b; -fx-font-size:11px;"/>
                    </VBox>
                </HBox>

                <Region minHeight="1" style="-fx-background-color:#eef2ff;"/>

                <Label fx:id="lblBatchName" text="Batch: --" style="-fx-text-fill:#334155; -fx-font-size:12px;"/>
                <Label fx:id="lblContact"   text="Email: --" style="-fx-text-fill:#334155; -fx-font-size:12px;"/>
                <Label fx:id="lblPhone"     text="Phone: --" style="-fx-text-fill:#334155; -fx-font-size:12px;"/>
                <Label fx:id="lblAdmission" text="Admission: --" style="-fx-text-fill:#334155; -fx-font-size:12px;"/>
            </VBox>

            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;
                         -fx-border-color:#e9edf5; -fx-border-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),12,0,0,3);">

                <Label text="Activity" style="-fx-text-fill:#0f172a; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="34"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-background-color:#f0fdf4; -fx-background-radius:10; -fx-padding:10;">
                        <Label text="PRESENT" style="-fx-text-fill:#16a34a; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblPresent" text="0" style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color:#fef2f2; -fx-background-radius:10; -fx-padding:10;">
                        <Label text="ABSENT" style="-fx-text-fill:#ef4444; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblAbsent" text="0" style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="0"
                          style="-fx-background-color:#fffbeb; -fx-background-radius:10; -fx-padding:10;">
                        <Label text="LATE" style="-fx-text-fill:#f59e0b; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblLate" text="0" style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
                          style="-fx-background-color:#f0fdf4; -fx-background-radius:10; -fx-padding:10;">
                        <Label text="PASS" style="-fx-text-fill:#16a34a; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblPass" text="0" style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"
                          style="-fx-background-color:#fef2f2; -fx-background-radius:10; -fx-padding:10;">
                        <Label text="FAIL" style="-fx-text-fill:#ef4444; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblFail" text="0" style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="1"
                          style="-fx-background-color:#fff7ed; -fx-background-radius:10; -fx-padding:10;">
                        <Label text="LEAVE" style="-fx-text-fill:#ea580c; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblLeave" text="0" style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    </VBox>
                </GridPane>

                <Label fx:id="lblLatestResult" text="Latest exam result: --"
                       style="-fx-text-fill:#475569; -fx-font-size:11px;"/>
            </VBox>

            <VBox spacing="12"
                  style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;
                         -fx-border-color:#e9edf5; -fx-border-radius:16;
                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),12,0,0,3);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Performance"
                           style="-fx-text-fill:#0f172a; -fx-font-size:14px; -fx-font-weight:bold;"
                           HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="cmbPerformancePeriod" prefHeight="32" prefWidth="160" promptText="Period"/>
                </HBox>

                <Label fx:id="lblPerformancePeriod" text="Performance: --"
                       style="-fx-text-fill:#94a3b8; -fx-font-size:10px; -fx-font-weight:bold;"/>

                <HBox spacing="10">
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color:#eef2ff; -fx-background-radius:10; -fx-padding:12;">
                        <Label text="ATTENDANCE" style="-fx-text-fill:#4f46e5; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblAttendanceRate" text="0.0%"
                               style="-fx-text-fill:#0f172a; -fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color:#ecfdf5; -fx-background-radius:10; -fx-padding:12;">
                        <Label text="GPA" style="-fx-text-fill:#16a34a; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblGpa" text="0.00"
                               style="-fx-text-fill:#0f172a; -fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </GridPane>
</VBox>
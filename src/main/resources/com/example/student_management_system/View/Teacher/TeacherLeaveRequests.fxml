<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Teacher.TeacherLeaveRequestsController"
            style="-fx-background-color:#f6f8fc;">

    <VBox spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
        <padding><Insets top="28" right="30" bottom="30" left="30"/></padding>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label text="Leave Requests"
                       style="-fx-text-fill:#0f172a;-fx-font-size:28px;-fx-font-weight:bold;"/>
                <Label text="View leave requests submitted for your students."
                       style="-fx-text-fill:#64748b;-fx-font-size:13px;"/>
            </VBox>
            <Label fx:id="lblRequestCount" text="0 requests"
                   style="-fx-text-fill:#4f46e5;-fx-background-color:#eef2ff;-fx-background-radius:12;-fx-padding:8 12;-fx-font-size:11px;-fx-font-weight:bold;"/>
        </HBox>

        <!-- FILTER BAR -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:16;-fx-border-color:#e8edf5;-fx-border-radius:16;">

            <VBox spacing="5">
                <Label text="BATCH"
                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                <ComboBox fx:id="cmbBatch" prefWidth="200" prefHeight="38" promptText="All Batches"/>
            </VBox>

            <VBox spacing="5">
                <Label text="STATUS"
                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                <ComboBox fx:id="cmbStatus" prefWidth="160" prefHeight="38" promptText="All"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="SEARCH"
                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                <TextField fx:id="txtSearch" prefHeight="38"
                           promptText="Search by student name, code or reason"/>
            </VBox>

            <VBox spacing="5">
                <Label text=" " style="-fx-font-size:10px;"/>
                <Button onAction="#refresh" minHeight="38"
                        style="-fx-background-color:#4f46e5;-fx-text-fill:white;-fx-background-radius:9;-fx-font-size:11px;-fx-font-weight:bold;-fx-padding:0 18;"
                        text="Refresh"/>
            </VBox>
        </HBox>

        <!-- MAIN -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- LEFT: table -->
            <VBox spacing="14"
                  style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;"
                  HBox.hgrow="ALWAYS">

                <VBox spacing="3">
                    <Label text="Leave Requests"
                           style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>
                    <Label text="Select a request to view its full details."
                           style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                </VBox>

                <TableView fx:id="leaveTable" prefHeight="500" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:white;-fx-border-color:#e2e8f0;-fx-border-radius:10;-fx-background-radius:10;">
                    <columns>
                        <TableColumn fx:id="colCode"   prefWidth="80"  text="Code"/>
                        <TableColumn fx:id="colName"   prefWidth="150" text="Student"/>
                        <TableColumn fx:id="colBatch"  prefWidth="140" text="Batch"/>
                        <TableColumn fx:id="colFrom"   prefWidth="110" text="From"/>
                        <TableColumn fx:id="colTo"     prefWidth="110" text="To"/>
                        <TableColumn fx:id="colStatus" prefWidth="100" text="Status"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- RIGHT: details -->
            <VBox minWidth="360" prefWidth="400" spacing="16">

                <!-- Profile card -->
                <VBox spacing="12"
                      style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;">

                    <Label fx:id="lblStudentName" text="No request selected"
                           style="-fx-text-fill:#0f172a;-fx-font-size:17px;-fx-font-weight:bold;"/>
                    <Label fx:id="lblStudentCode" text="Select a row to view details"
                           style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>

                    <Region minHeight="1" style="-fx-background-color:#eef2ff;"/>

                    <Label fx:id="lblBatch" text="Batch: --"
                           style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                    <Label fx:id="lblDates" text="From: --    To: --"
                           style="-fx-text-fill:#334155;-fx-font-size:12px;"/>
                    <Label fx:id="lblDays" text="--"
                           style="-fx-text-fill:#4f46e5;-fx-font-size:14px;-fx-font-weight:bold;"/>
                    <Label fx:id="lblStatus" text="Status: --"
                           style="-fx-text-fill:#d97706;-fx-font-size:12px;-fx-font-weight:bold;"/>
                    <Label fx:id="lblApprovedBy" text="Handled by: --"
                           style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>
                </VBox>

                <!-- Reason card -->
                <VBox spacing="8"
                      style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;">

                    <Label text="REASON"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                    <TextArea fx:id="txtReason" editable="false" wrapText="true"
                              prefRowCount="5"
                              style="-fx-background-color:#f8fafc;-fx-border-color:#e2e8f0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;"/>
                </VBox>

                <!-- Counters -->
                <VBox spacing="10"
                      style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;">

                    <Label text="SUMMARY"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                    <HBox spacing="10">
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#eef2ff;-fx-background-radius:11;-fx-padding:12;">
                            <Label text="TOTAL"
                                   style="-fx-text-fill:#4f46e5;-fx-font-size:9px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblTotal" text="0"
                                   style="-fx-text-fill:#312e81;-fx-font-size:20px;-fx-font-weight:bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#fffbeb;-fx-background-radius:11;-fx-padding:12;">
                            <Label text="PENDING"
                                   style="-fx-text-fill:#d97706;-fx-font-size:9px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblPending" text="0"
                                   style="-fx-text-fill:#92400e;-fx-font-size:20px;-fx-font-weight:bold;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#ecfdf5;-fx-background-radius:11;-fx-padding:12;">
                            <Label text="APPROVED"
                                   style="-fx-text-fill:#059669;-fx-font-size:9px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblApproved" text="0"
                                   style="-fx-text-fill:#065f46;-fx-font-size:20px;-fx-font-weight:bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#fff1f2;-fx-background-radius:11;-fx-padding:12;">
                            <Label text="REJECTED"
                                   style="-fx-text-fill:#e11d48;-fx-font-size:9px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblRejected" text="0"
                                   style="-fx-text-fill:#9f1239;-fx-font-size:20px;-fx-font-weight:bold;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
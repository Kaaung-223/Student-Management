<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Teacher.TeacherSubjectsController"
            style="-fx-background-color:#f6f8fc;">

    <VBox spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
        <padding><Insets top="28" right="30" bottom="30" left="30"/></padding>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label text="My Subjects"
                       style="-fx-text-fill:#0f172a;-fx-font-size:28px;-fx-font-weight:bold;"/>
                <Label text="Subjects you teach and the classes using them."
                       style="-fx-text-fill:#64748b;-fx-font-size:13px;"/>
            </VBox>
            <Label fx:id="lblSubjectCount" text="0 subjects"
                   style="-fx-text-fill:#4f46e5;-fx-background-color:#eef2ff;-fx-background-radius:12;-fx-padding:8 12;-fx-font-size:11px;-fx-font-weight:bold;"/>
        </HBox>

        <!-- SEARCH BAR -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:16;-fx-border-color:#e8edf5;-fx-border-radius:16;">

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="SEARCH SUBJECT"
                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                <TextField fx:id="txtSearch" prefHeight="38"
                           promptText="Search by subject name or code"/>
            </VBox>

            <VBox spacing="5">
                <Label text=" " style="-fx-font-size:10px;"/>
                <Button onAction="#refresh" minHeight="38"
                        style="-fx-background-color:#4f46e5;-fx-text-fill:white;-fx-background-radius:9;-fx-font-size:11px;-fx-font-weight:bold;-fx-padding:0 18;"
                        text="Refresh"/>
            </VBox>
        </HBox>

        <!-- MAIN -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- LEFT: subject table -->
            <VBox spacing="14"
                  style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:20;-fx-border-color:#e8edf5;-fx-border-radius:18;"
                  HBox.hgrow="ALWAYS">

                <VBox spacing="3">
                    <Label text="Subject List"
                           style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>
                    <Label text="Select a subject to view details."
                           style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                </VBox>

                <TableView fx:id="subjectTable" prefHeight="500" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:white;-fx-border-color:#e2e8f0;-fx-border-radius:10;-fx-background-radius:10;">
                    <columns>
                        <TableColumn fx:id="colName"    prefWidth="220" text="Subject"/>
                        <TableColumn fx:id="colCode"    prefWidth="120" text="Code"/>
                        <TableColumn fx:id="colClasses" prefWidth="360" text="Classes Using It"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- RIGHT: details card -->
            <VBox minWidth="300" prefWidth="330" spacing="16"
                  style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:22;-fx-border-color:#e8edf5;-fx-border-radius:18;">

                <VBox spacing="3">
                    <Label fx:id="lblSubjectName" text="No subject selected"
                           style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>
                    <Label fx:id="lblSubjectCode" text="Select a row to view details"
                           style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>
                </VBox>

                <Region minHeight="1" style="-fx-background-color:#eef2ff;"/>

                <Label fx:id="lblClasses" text="Classes: --"
                       wrapText="true"
                       style="-fx-text-fill:#334155;-fx-font-size:12px;"/>

                <VBox spacing="10">
                    <Label text="OVERVIEW"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                    <HBox spacing="10">
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#eef2ff;-fx-background-radius:11;-fx-padding:14;">
                            <Label text="STUDENTS"
                                   style="-fx-text-fill:#4f46e5;-fx-font-size:9px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblStudentCount" text="0"
                                   style="-fx-text-fill:#312e81;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#ecfdf5;-fx-background-radius:11;-fx-padding:14;">
                            <Label text="AVG SCORE"
                                   style="-fx-text-fill:#059669;-fx-font-size:9px;-fx-font-weight:bold;"/>
                            <Label fx:id="lblAvgScore" text="0.0 percent"
                                   style="-fx-text-fill:#065f46;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
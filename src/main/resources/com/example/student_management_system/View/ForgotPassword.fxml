<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="620" prefWidth="520"
           style="-fx-background-color:#f8fafc;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.ForgotPasswordController">

    <VBox maxWidth="440" maxHeight="560" spacing="18"
          style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:30;
                 -fx-border-color:#e2e8f0;-fx-border-radius:16;
                 -fx-effect:dropshadow(gaussian,rgba(15,23,42,.12),24,0,0,8);">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane minHeight="42" minWidth="42"
                       style="-fx-background-color:#eef2ff;-fx-background-radius:12;">
                <FontIcon iconLiteral="fas-key" iconSize="18" iconColor="#4f46e5"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Reset your password"
                       style="-fx-font-size:19px;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                <Label text="We'll email you a 6-digit code."
                       style="-fx-font-size:12px;-fx-text-fill:#64748b;"/>
            </VBox>
        </HBox>

        <StackPane fx:id="stepContainer">

            <!-- STEP 1: EMAIL -->
            <VBox fx:id="stepEmailPane" spacing="14">
                <VBox spacing="7">
                    <Label text="EMAIL ADDRESS"
                           style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                    <TextField fx:id="txtEmail" prefHeight="46"
                               promptText="you@example.com"
                               style="-fx-background-color:white;-fx-background-radius:10;
                                      -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                      -fx-font-size:13px;-fx-padding:0 14;"/>
                </VBox>

                <Button fx:id="btnSendOtp" maxWidth="Infinity" minHeight="46"
                        text="SEND OTP"
                        onAction="#handleSendOtp"
                        style="-fx-background-color:#4f46e5;-fx-text-fill:white;
                               -fx-background-radius:10;-fx-font-size:13px;
                               -fx-font-weight:bold;-fx-cursor:hand;"/>
            </VBox>

            <!-- STEP 2: OTP -->
            <VBox fx:id="stepOtpPane" spacing="14" managed="false" visible="false">
                <VBox spacing="7">
                    <Label text="6-DIGIT CODE"
                           style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                    <TextField fx:id="txtOtp" prefHeight="52" maxWidth="Infinity"
                               promptText="••••••"
                               style="-fx-background-color:white;-fx-background-radius:10;
                                      -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                      -fx-font-size:22px;-fx-font-weight:bold;
                                      -fx-padding:0 14;-fx-alignment:CENTER;"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="lblCountdown" text="Expires in 30s"
                           style="-fx-font-size:12px;-fx-text-fill:#dc2626;-fx-font-weight:bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink fx:id="lnkResend" text="Resend code"
                               onAction="#handleResendOtp"
                               style="-fx-font-size:12px;-fx-text-fill:#4f46e5;-fx-font-weight:bold;"/>
                </HBox>

                <Button fx:id="btnVerifyOtp" maxWidth="Infinity" minHeight="46"
                        text="VERIFY CODE"
                        onAction="#handleVerifyOtp"
                        style="-fx-background-color:#4f46e5;-fx-text-fill:white;
                               -fx-background-radius:10;-fx-font-size:13px;
                               -fx-font-weight:bold;-fx-cursor:hand;"/>

                <Hyperlink text="← Change email" onAction="#handleBackToEmail"
                           style="-fx-font-size:12px;-fx-text-fill:#64748b;"/>
            </VBox>

            <!-- STEP 3: NEW PASSWORD -->
            <VBox fx:id="stepPasswordPane" spacing="14" managed="false" visible="false">
                <VBox spacing="7">
                    <Label text="NEW PASSWORD"
                           style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                    <PasswordField fx:id="txtNewPassword" prefHeight="46"
                                   promptText="Enter new password"
                                   style="-fx-background-color:white;-fx-background-radius:10;
                                          -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                          -fx-font-size:13px;-fx-padding:0 14;"/>
                </VBox>
                <VBox spacing="7">
                    <Label text="CONFIRM PASSWORD"
                           style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                    <PasswordField fx:id="txtConfirmPassword" prefHeight="46"
                                   promptText="Re-enter password"
                                   style="-fx-background-color:white;-fx-background-radius:10;
                                          -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                          -fx-font-size:13px;-fx-padding:0 14;"/>
                </VBox>

                <Button fx:id="btnResetPassword" maxWidth="Infinity" minHeight="46"
                        text="RESET PASSWORD"
                        onAction="#handleResetPassword"
                        style="-fx-background-color:#4f46e5;-fx-text-fill:white;
                               -fx-background-radius:10;-fx-font-size:13px;
                               -fx-font-weight:bold;-fx-cursor:hand;"/>
            </VBox>

        </StackPane>

        <Label fx:id="lblMessage" wrapText="true" maxWidth="Infinity"
               style="-fx-font-size:12px;-fx-text-fill:#dc2626;"/>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER">
            <Hyperlink text="Back to sign in" onAction="#handleBackToLogin"
                       style="-fx-font-size:12px;-fx-text-fill:#64748b;"/>
        </HBox>

    </VBox>
</StackPane>
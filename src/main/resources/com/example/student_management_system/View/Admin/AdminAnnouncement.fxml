<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
            maxHeight="Infinity" maxWidth="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Admin.AdminAnnouncementController"
            style="-fx-background-color: #f4f6f9;">

    <BorderPane prefHeight="650.0" prefWidth="950.0"
                style="-fx-background-color: transparent;"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Top Header Section -->
        <top>
            <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;"
                  BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
                </padding>
                <children>
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Announcement Management" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Create, edit, and target broadcast notices for teachers and staff." />
                </children>
            </VBox>
        </top>

        <!-- Left Sidebar Form Section -->
        <left>
            <VBox prefWidth="340.0" spacing="14.0"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);"
                  BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <BorderPane.margin>
                    <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
                </BorderPane.margin>
                <children>
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Announcement Details" />

                    <VBox spacing="4.0">
                        <children>
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Title" />
                            <TextField fx:id="txtTitle" promptText="Enter announcement title"
                                       style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 8px;" />
                        </children>
                    </VBox>

                    <VBox spacing="4.0">
                        <children>
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Target Audience" />
                            <ComboBox fx:id="cbTargetAudience" maxWidth="Infinity"
                                      style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 3px;" />
                        </children>
                    </VBox>

                    <VBox spacing="4.0">
                        <children>
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Announcement Date" />
                            <DatePicker fx:id="dpAnnouncementDate" maxWidth="Infinity"
                                        style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 3px;" />
                        </children>
                    </VBox>

                    <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                        <children>
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Reason / Details" />
                            <TextArea fx:id="txtReason" prefHeight="130.0"
                                      promptText="Enter detailed description or reason..."
                                      style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"
                                      wrapText="true" />
                        </children>
                    </VBox>

                    <!-- Action Buttons Grid – Updated Design -->
                    <VBox spacing="8.0">
                        <children>
                            <HBox spacing="10.0">
                                <children>
                                    <Button maxWidth="Infinity" onAction="#handleSave"
                                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.3), 8, 0, 0, 2);"
                                            text="Save" HBox.hgrow="ALWAYS" />
                                    <Button maxWidth="Infinity" onAction="#handleUpdate"
                                            style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(13,148,136,0.3), 8, 0, 0, 2);"
                                            text="Update" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                            <HBox spacing="10.0">
                                <children>
                                    <Button maxWidth="Infinity" onAction="#handleDelete"
                                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.3), 8, 0, 0, 2);"
                                            text="Delete" HBox.hgrow="ALWAYS" />
                                    <Button maxWidth="Infinity" onAction="#handleClear"
                                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(100,116,139,0.3), 8, 0, 0, 2);"
                                            text="Clear" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                        </children>
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </VBox>
                </children>
            </VBox>
        </left>

        <!-- Center Table View Section -->
        <center>
            <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);"
                  BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
                </BorderPane.margin>
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>
                <children>
                    <TableView fx:id="tableAnnouncements" style="-fx-background-color: transparent; -fx-base: #ffffff;"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="45.0" style="-fx-alignment: CENTER;" text="ID" />
                            <TableColumn fx:id="colTitle" prefWidth="130.0" text="Title" />
                            <TableColumn fx:id="colTarget" prefWidth="85.0" style="-fx-alignment: CENTER;" text="Target" />
                            <TableColumn fx:id="colDate" prefWidth="95.0" style="-fx-alignment: CENTER;" text="Date" />
                            <TableColumn fx:id="colReason" prefWidth="145.0" text="Reason / Details" />
                            <TableColumn fx:id="colCreatedBy" prefWidth="95.0" text="Created By" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>
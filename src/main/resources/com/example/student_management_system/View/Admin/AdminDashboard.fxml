<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="650"
            minWidth="1000"
            style="-fx-background-color:#f6f8fc;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Admin.AdminDashboardController">

    <!-- ========================================================= -->
    <!-- LEFT SIDEBAR -->
    <!-- ========================================================= -->

    <left>

        <VBox maxWidth="260"
              minWidth="235"
              prefWidth="250"
              spacing="6"
              style="-fx-background-color:linear-gradient(to bottom,#111827,#1e293b);">

            <padding>
                <Insets top="25"
                        right="16"
                        bottom="20"
                        left="16"/>
            </padding>


            <!-- LOGO -->
            <HBox spacing="12"
                  style="-fx-padding:0 4 25 4;">

                <StackPane minHeight="43"
                           minWidth="43"
                           style="-fx-background-color:#4f46e5;
                                  -fx-background-radius:13;
                                  -fx-effect:dropshadow(gaussian,rgba(79,70,229,.35),12,0,0,3);">

                    <Label style="-fx-text-fill:white;
                                  -fx-font-size:20px;
                                  -fx-font-weight:bold;"
                           text="S"/>
                </StackPane>


                <VBox spacing="2">

                    <Label style="-fx-text-fill:white;
                                  -fx-font-size:18px;
                                  -fx-font-weight:bold;"
                           text="StudentHub"/>

                    <Label style="-fx-text-fill:#94a3b8;
                                  -fx-font-size:9px;
                                  -fx-font-weight:bold;"
                           text="MANAGEMENT SYSTEM"/>

                </VBox>

            </HBox>


            <!-- MENU TITLE -->

            <Label style="-fx-text-fill:#64748b;
                          -fx-font-size:10px;
                          -fx-font-weight:bold;
                          -fx-padding:2 8 8 8;"
                   text="MAIN MENU"/>


            <!-- MENU -->

            <VBox spacing="5"
                  VBox.vgrow="ALWAYS">

                <Button fx:id="btnDashboard"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#refreshDashboard"
                        style="-fx-background-color:#4f46e5;
                               -fx-background-radius:10;
                               -fx-text-fill:white;
                               -fx-font-size:13px;
                               -fx-font-weight:bold;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Dashboard"/>


                <Button fx:id="btnStudents"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openStudents"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Students"/>


                <Button fx:id="btnTeachers"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openTeachers"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Teachers"/>


                <Button fx:id="btnClasses"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openClasses"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Classes"/>


                <Button fx:id="btnClassFees"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openClassFees"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Class Fees"/>


                <Button fx:id="btnSubjects"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openSubjects"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Subjects"/>


                <Button fx:id="btnExams"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openExams"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Exams"/>


                <Button fx:id="btnGrades"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openGrades"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Grades / Results"/>


                <Button fx:id="btnAttendance"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openAttendance"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Attendance"/>


                <Button fx:id="btnLeave"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openLeaveRequests"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Leave Requests"/>


                <Button fx:id="btnAnnouncements"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openAnnouncements"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Announcements"/>


                <Button fx:id="btnProfile"
                        maxWidth="Infinity"
                        minHeight="44"
                        onAction="#openProfile"
                        style="-fx-background-color:transparent;
                               -fx-text-fill:#cbd5e1;
                               -fx-font-size:13px;
                               -fx-alignment:CENTER_LEFT;
                               -fx-padding:0 16;
                               -fx-cursor:hand;"
                        text="Profile"/>

            </VBox>


            <!-- LOGOUT -->

            <Button fx:id="btnLogout"
                    maxWidth="Infinity"
                    minHeight="44"
                    onAction="#logout"
                    style="-fx-background-color:#312e3f;
                           -fx-text-fill:#fda4af;
                           -fx-background-radius:10;
                           -fx-cursor:hand;
                           -fx-font-weight:bold;"
                    text="Logout"/>

        </VBox>

    </left>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <StackPane fx:id="contentPane">


            <!-- ================================================= -->
            <!-- DASHBOARD -->
            <!-- ================================================= -->

            <ScrollPane fx:id="dashboardScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        style="-fx-background:#f6f8fc;
                               -fx-border-color:transparent;">

                <content>

                    <VBox spacing="24"
                          style="-fx-background-color:#f6f8fc;">

                        <padding>
                            <Insets top="30"
                                    right="34"
                                    bottom="35"
                                    left="34"/>
                        </padding>


                        <!-- ===================================== -->
                        <!-- HEADER -->
                        <!-- ===================================== -->

                        <HBox alignment="CENTER_LEFT" spacing="16">

                            <VBox HBox.hgrow="ALWAYS"
                                  spacing="6">

                                <HBox spacing="12"
                                      alignment="CENTER_LEFT">

                                    <Region minWidth="6"
                                            minHeight="34"
                                            style="-fx-background-color:linear-gradient(to bottom,#4f46e5,#6366f1);
                                                   -fx-background-radius:8;"/>

                                    <VBox spacing="3">
                                        <Label style="-fx-text-fill:#0f172a;
                                                      -fx-font-size:30px;
                                                      -fx-font-weight:bold;"
                                               text="Dashboard"/>
                                        <Label style="-fx-text-fill:#64748b;
                                                      -fx-font-size:13px;"
                                               text="Students, attendance, exams, and fee collections at a glance"/>
                                    </VBox>

                                </HBox>

                            </VBox>


                            <!-- ADMIN INFO -->

                            <HBox alignment="CENTER_LEFT"
                                  spacing="12"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:14;
                                         -fx-padding:10 16;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:14;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),12,0,0,3);">

                                <StackPane minHeight="38"
                                           minWidth="38"
                                           style="-fx-background-color:#eef2ff;
                                                  -fx-background-radius:19;">
                                    <Label style="-fx-text-fill:#4f46e5;
                                                  -fx-font-size:14px;
                                                  -fx-font-weight:bold;"
                                           text="A"/>
                                </StackPane>

                                <VBox spacing="1">

                                    <Label style="-fx-text-fill:#94a3b8;
                                                  -fx-font-size:9px;
                                                  -fx-font-weight:bold;"
                                           text="ADMINISTRATOR"/>

                                    <Label fx:id="lblAdminName"
                                           style="-fx-text-fill:#1e293b;
                                                  -fx-font-size:13px;
                                                  -fx-font-weight:bold;"
                                           text="Administrator"/>

                                </VBox>

                            </HBox>

                        </HBox>


                        <!-- ===================================== -->
                        <!-- STAT CARDS -->
                        <!-- ===================================== -->

                        <GridPane hgap="18">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>

                            </columnConstraints>


                            <!-- STUDENTS -->

                            <VBox spacing="12"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:18;
                                         -fx-padding:18;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:18;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="0">

                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40"
                                               style="-fx-background-color:#eef2ff; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#6366f1; -fx-font-size:14px; -fx-font-weight:bold;" text="ST"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#6366f1; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="TOTAL STUDENTS"/>
                                </HBox>

                                <Label fx:id="lblTotalStudents"
                                       style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;"
                                       text="0"/>

                                <Region minHeight="4"
                                        style="-fx-background-color:linear-gradient(to right,#6366f1,#a5b4fc);
                                               -fx-background-radius:4;"/>

                            </VBox>


                            <!-- TEACHERS -->

                            <VBox spacing="12"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:18;
                                         -fx-padding:18;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:18;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="1">

                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40"
                                               style="-fx-background-color:#ecfeff; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#0891b2; -fx-font-size:14px; -fx-font-weight:bold;" text="TR"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#0891b2; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="TOTAL TEACHERS"/>
                                </HBox>

                                <Label fx:id="lblTotalTeachers"
                                       style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;"
                                       text="0"/>

                                <Region minHeight="4"
                                        style="-fx-background-color:linear-gradient(to right,#0891b2,#67e8f9);
                                               -fx-background-radius:4;"/>

                            </VBox>


                            <!-- CLASSES -->

                            <VBox spacing="12"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:18;
                                         -fx-padding:18;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:18;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="2">

                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40"
                                               style="-fx-background-color:#f0fdf4; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#16a34a; -fx-font-size:14px; -fx-font-weight:bold;" text="CL"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#16a34a; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="TOTAL CLASSES"/>
                                </HBox>

                                <Label fx:id="lblTotalClasses"
                                       style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;"
                                       text="0"/>

                                <Region minHeight="4"
                                        style="-fx-background-color:linear-gradient(to right,#16a34a,#86efac);
                                               -fx-background-radius:4;"/>

                            </VBox>


                            <!-- SUBJECTS -->

                            <VBox spacing="12"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:18;
                                         -fx-padding:18;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:18;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="3">

                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40"
                                               style="-fx-background-color:#fff7ed; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#ea580c; -fx-font-size:14px; -fx-font-weight:bold;" text="SB"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#ea580c; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="TOTAL SUBJECTS"/>
                                </HBox>

                                <Label fx:id="lblTotalSubjects"
                                       style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;"
                                       text="0"/>

                                <Region minHeight="4"
                                        style="-fx-background-color:linear-gradient(to right,#ea580c,#fdba74);
                                               -fx-background-radius:4;"/>

                            </VBox>

                        </GridPane>


                        <!-- ===================================== -->
                        <!-- ATTENDANCE + EXAM -->
                        <!-- ===================================== -->

                        <GridPane hgap="20">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>

                            </columnConstraints>


                            <!-- ATTENDANCE -->

                            <VBox spacing="14"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:18;
                                         -fx-padding:22;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:18;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="0">

                                <HBox alignment="CENTER_LEFT">

                                    <VBox HBox.hgrow="ALWAYS"
                                          spacing="3">

                                        <Label style="-fx-text-fill:#0f172a;
                                                      -fx-font-size:18px;
                                                      -fx-font-weight:bold;"
                                               text="Attendance Overview"/>

                                        <Label style="-fx-text-fill:#94a3b8;
                                                      -fx-font-size:11px;"
                                               text="Monitor student attendance"/>

                                    </VBox>

                                    <Region minWidth="5"
                                            minHeight="28"
                                            style="-fx-background-color:#4f46e5;
                                                   -fx-background-radius:4;"/>

                                </HBox>


                                <HBox spacing="10">

                                    <ComboBox fx:id="cmbAttendancePeriod"
                                              prefHeight="38"
                                              prefWidth="145"
                                              promptText="Period"/>

                                    <ComboBox fx:id="cmbAttendanceBatch"
                                              prefHeight="38"
                                              promptText="Batch"
                                              HBox.hgrow="ALWAYS"/>

                                </HBox>


                                <PieChart fx:id="attendancePieChart"
                                          legendVisible="false"
                                          minHeight="220"
                                          prefHeight="220"
                                          VBox.vgrow="ALWAYS"/>


                                <HBox spacing="12"
                                      style="-fx-background-color:#f8fafc;
                                             -fx-background-radius:12;
                                             -fx-padding:12;">

                                    <VBox HBox.hgrow="ALWAYS">

                                        <Label style="-fx-text-fill:#16a34a;
                                                      -fx-font-size:10px;
                                                      -fx-font-weight:bold;"
                                               text="PRESENT"/>

                                        <Label fx:id="lblPresentCount"
                                               style="-fx-font-size:18px;
                                                      -fx-font-weight:bold;
                                                      -fx-text-fill:#0f172a;"
                                               text="0"/>

                                    </VBox>


                                    <VBox HBox.hgrow="ALWAYS">

                                        <Label style="-fx-text-fill:#ef4444;
                                                      -fx-font-size:10px;
                                                      -fx-font-weight:bold;"
                                               text="ABSENT"/>

                                        <Label fx:id="lblAbsentCount"
                                               style="-fx-font-size:18px;
                                                      -fx-font-weight:bold;
                                                      -fx-text-fill:#0f172a;"
                                               text="0"/>

                                    </VBox>


                                    <VBox HBox.hgrow="ALWAYS">

                                        <Label style="-fx-text-fill:#f59e0b;
                                                      -fx-font-size:10px;
                                                      -fx-font-weight:bold;"
                                               text="LATE"/>

                                        <Label fx:id="lblLateCount"
                                               style="-fx-font-size:18px;
                                                      -fx-font-weight:bold;
                                                      -fx-text-fill:#0f172a;"
                                               text="0"/>

                                    </VBox>

                                </HBox>

                            </VBox>


                            <!-- EXAM -->

                            <VBox spacing="14"
                                  style="-fx-background-color:white;
                                         -fx-background-radius:18;
                                         -fx-padding:22;
                                         -fx-border-color:#e9edf5;
                                         -fx-border-radius:18;
                                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="1">

                                <HBox alignment="CENTER_LEFT">

                                    <VBox HBox.hgrow="ALWAYS"
                                          spacing="3">

                                        <Label style="-fx-text-fill:#0f172a;
                                                      -fx-font-size:18px;
                                                      -fx-font-weight:bold;"
                                               text="Exam Results"/>

                                        <Label style="-fx-text-fill:#94a3b8;
                                                      -fx-font-size:11px;"
                                               text="Monitor student performance"/>

                                    </VBox>

                                    <Region minWidth="5"
                                            minHeight="28"
                                            style="-fx-background-color:#8b5cf6;
                                                   -fx-background-radius:4;"/>

                                </HBox>


                                <ComboBox fx:id="cmbExam"
                                          maxWidth="Infinity"
                                          prefHeight="38"
                                          promptText="Select Exam"/>


                                <PieChart fx:id="examPieChart"
                                          legendVisible="false"
                                          minHeight="220"
                                          prefHeight="220"
                                          VBox.vgrow="ALWAYS"/>


                                <HBox spacing="12"
                                      style="-fx-background-color:#f8fafc;
                                             -fx-background-radius:12;
                                             -fx-padding:12;">

                                    <VBox HBox.hgrow="ALWAYS">

                                        <Label style="-fx-text-fill:#16a34a;
                                                      -fx-font-size:10px;
                                                      -fx-font-weight:bold;"
                                               text="PASS"/>

                                        <Label fx:id="lblPassCount"
                                               style="-fx-font-size:18px;
                                                      -fx-font-weight:bold;
                                                      -fx-text-fill:#0f172a;"
                                               text="0"/>

                                    </VBox>


                                    <VBox HBox.hgrow="ALWAYS">

                                        <Label style="-fx-text-fill:#ef4444;
                                                      -fx-font-size:10px;
                                                      -fx-font-weight:bold;"
                                               text="FAIL"/>

                                        <Label fx:id="lblFailCount"
                                               style="-fx-font-size:18px;
                                                      -fx-font-weight:bold;
                                                      -fx-text-fill:#0f172a;"
                                               text="0"/>

                                    </VBox>

                                </HBox>

                            </VBox>

                        </GridPane>


                        <!-- ===================================== -->
                        <!-- FINANCIAL STATEMENT -->
                        <!-- ===================================== -->

                        <VBox spacing="16"
                              style="-fx-background-color:white;
                                     -fx-background-radius:18;
                                     -fx-padding:22;
                                     -fx-border-color:#e9edf5;
                                     -fx-border-radius:18;
                                     -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);">

                            <HBox spacing="16" alignment="CENTER_LEFT">

                                <VBox HBox.hgrow="ALWAYS" spacing="3">
                                    <Label style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"
                                           text="Financial Statement"/>
                                    <Label style="-fx-text-fill:#94a3b8; -fx-font-size:11px;"
                                           text="Expected fees, collected payments, and outstanding balances"/>
                                </VBox>

                                <ComboBox fx:id="cmbFinanceBatch"
                                          prefHeight="38"
                                          prefWidth="210"
                                          promptText="All Batches"/>

                            </HBox>

                            <HBox spacing="12">

                                <VBox spacing="4" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color:#f8fafc; -fx-background-radius:12; -fx-padding:12 14;">
                                    <Label style="-fx-text-fill:#64748b; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="EXPECTED"/>
                                    <Label fx:id="lblFinanceExpected"
                                           style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;"
                                           text="0 MMK"/>
                                </VBox>

                                <VBox spacing="4" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color:#f0fdf4; -fx-background-radius:12; -fx-padding:12 14;">
                                    <Label style="-fx-text-fill:#16a34a; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="COLLECTED"/>
                                    <Label fx:id="lblFinanceCollected"
                                           style="-fx-text-fill:#15803d; -fx-font-size:18px; -fx-font-weight:bold;"
                                           text="0 MMK"/>
                                </VBox>

                                <VBox spacing="4" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color:#fef2f2; -fx-background-radius:12; -fx-padding:12 14;">
                                    <Label style="-fx-text-fill:#dc2626; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="OUTSTANDING"/>
                                    <Label fx:id="lblFinanceOutstanding"
                                           style="-fx-text-fill:#b91c1c; -fx-font-size:18px; -fx-font-weight:bold;"
                                           text="0 MMK"/>
                                </VBox>

                                <VBox spacing="4" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color:#eef2ff; -fx-background-radius:12; -fx-padding:12 14;">
                                    <Label style="-fx-text-fill:#4f46e5; -fx-font-size:10px; -fx-font-weight:bold;"
                                           text="PAID / UNPAID"/>
                                    <Label fx:id="lblFinancePaidUnpaid"
                                           style="-fx-text-fill:#3730a3; -fx-font-size:18px; -fx-font-weight:bold;"
                                           text="0 / 0"/>
                                </VBox>

                            </HBox>

                            <GridPane hgap="20">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="38"/>
                                    <ColumnConstraints percentWidth="62"/>
                                </columnConstraints>

                                <VBox spacing="8" GridPane.columnIndex="0">
                                    <Label style="-fx-text-fill:#334155; -fx-font-size:13px; -fx-font-weight:bold;"
                                           text="Collected vs Outstanding"/>
                                    <PieChart fx:id="financePieChart"
                                              legendVisible="true"
                                              minHeight="240"
                                              prefHeight="240"/>
                                </VBox>

                                <VBox spacing="8" GridPane.columnIndex="1">
                                    <Label style="-fx-text-fill:#334155; -fx-font-size:13px; -fx-font-weight:bold;"
                                           text="Fees by batch"/>
                                    <BarChart fx:id="financeBarChart"
                                              legendVisible="true"
                                              minHeight="240"
                                              prefHeight="260"
                                              animated="false">
                                        <xAxis>
                                            <CategoryAxis label="Batch"/>
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis label="Amount (MMK)"/>
                                        </yAxis>
                                    </BarChart>
                                </VBox>
                            </GridPane>

                        </VBox>


                        <!-- ===================================== -->
                        <!-- STUDENTS -->
                        <!-- ===================================== -->

                        <VBox spacing="14"
                              style="-fx-background-color:white;
                                     -fx-background-radius:18;
                                     -fx-padding:22;
                                     -fx-border-color:#e9edf5;
                                     -fx-border-radius:18;
                                     -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);">

                            <HBox spacing="16">

                                <VBox HBox.hgrow="ALWAYS"
                                      spacing="3">

                                    <Label style="-fx-text-fill:#0f172a;
                                                  -fx-font-size:18px;
                                                  -fx-font-weight:bold;"
                                           text="Students by Batch"/>

                                    <Label style="-fx-text-fill:#94a3b8;
                                                  -fx-font-size:11px;"
                                           text="Browse and monitor your enrolled students"/>

                                </VBox>


                                <ComboBox fx:id="cmbStudentsBatch"
                                          prefHeight="38"
                                          prefWidth="210"
                                          promptText="All Batches"/>


                                <Button onAction="#refreshDashboard"
                                        style="-fx-background-color:#4f46e5;
                                               -fx-text-fill:white;
                                               -fx-background-radius:9;
                                               -fx-font-weight:bold;
                                               -fx-padding:0 16;
                                               -fx-cursor:hand;"
                                        text="Refresh"/>

                            </HBox>


                            <TableView fx:id="studentTable"
                                       prefHeight="230">

                                <columns>

                                    <TableColumn fx:id="studentCodeColumn"
                                                 prefWidth="140"
                                                 text="Student Code"/>

                                    <TableColumn fx:id="studentNameColumn"
                                                 prefWidth="190"
                                                 text="Student Name"/>

                                    <TableColumn fx:id="studentEmailColumn"
                                                 prefWidth="260"
                                                 text="Email"/>

                                    <TableColumn fx:id="studentBatchColumn"
                                                 prefWidth="140"
                                                 text="Batch"/>

                                    <TableColumn fx:id="studentStatusColumn"
                                                 prefWidth="110"
                                                 text="Status"/>

                                </columns>

                            </TableView>

                        </VBox>


                        <!-- ===================================== -->
                        <!-- LEAVE REQUESTS -->
                        <!-- ===================================== -->

                        <VBox spacing="14"
                              style="-fx-background-color:white;
                                     -fx-background-radius:18;
                                     -fx-padding:22;
                                     -fx-border-color:#e9edf5;
                                     -fx-border-radius:18;
                                     -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);">

                            <HBox spacing="16">

                                <VBox HBox.hgrow="ALWAYS"
                                      spacing="3">

                                    <Label style="-fx-text-fill:#0f172a;
                                                  -fx-font-size:18px;
                                                  -fx-font-weight:bold;"
                                           text="Pending Leave Requests"/>

                                    <Label style="-fx-text-fill:#94a3b8;
                                                  -fx-font-size:11px;"
                                           text="Students waiting for approval"/>

                                </VBox>


                                <ComboBox fx:id="cmbLeaveBatch"
                                          prefHeight="38"
                                          prefWidth="210"
                                          promptText="All Batches"/>

                            </HBox>


                            <TableView fx:id="leaveTable"
                                       prefHeight="210">

                                <columns>

                                    <TableColumn fx:id="leaveStudentColumn"
                                                 prefWidth="220"
                                                 text="Student"/>

                                    <TableColumn fx:id="leaveBatchColumn"
                                                 prefWidth="150"
                                                 text="Batch"/>

                                    <TableColumn fx:id="leaveFromColumn"
                                                 prefWidth="150"
                                                 text="Leave From"/>

                                    <TableColumn fx:id="leaveToColumn"
                                                 prefWidth="150"
                                                 text="Leave To"/>

                                    <TableColumn fx:id="leaveStatusColumn"
                                                 prefWidth="130"
                                                 text="Status"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </VBox>

                </content>

            </ScrollPane>


            <!-- ================================================ -->
            <!-- OTHER PAGE CONTENT -->
            <!-- ================================================ -->

            <AnchorPane fx:id="adminPane"
                        visible="false"/>


            <!-- ================================================ -->
            <!-- WELCOME TOAST -->
            <!-- ================================================ -->

            <VBox fx:id="welcomeToast"
                  managed="false"
                  visible="false"
                  maxWidth="350"
                  prefWidth="350"
                  spacing="8"
                  StackPane.alignment="TOP_RIGHT"
                  translateX="-24"
                  translateY="24"
                  style="-fx-background-color:white;
                         -fx-background-radius:15;
                         -fx-padding:15 17 15 15;
                         -fx-border-color:#e2e8f0;
                         -fx-border-radius:15;
                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.20),22,0,0,6);">

                <HBox spacing="12"
                      alignment="CENTER_LEFT">

                    <!-- SUCCESS ICON -->

                    <StackPane minHeight="38"
                               minWidth="38"
                               style="-fx-background-color:#dcfce7;
                                      -fx-background-radius:19;">

                        <Label style="-fx-text-fill:#16a34a;
                                      -fx-font-size:17px;
                                      -fx-font-weight:bold;"
                               text="✓"/>

                    </StackPane>


                    <!-- MESSAGE -->

                    <VBox spacing="3"
                          HBox.hgrow="ALWAYS">

                        <Label style="-fx-text-fill:#64748b;
                                      -fx-font-size:9px;
                                      -fx-font-weight:bold;"
                               text="LOGIN SUCCESSFUL"/>

                        <Label style="-fx-text-fill:#0f172a;
                                      -fx-font-size:14px;
                                      -fx-font-weight:bold;"
                               text="Welcome back!"/>

                        <Label fx:id="lblDashboardWelcome"
                               style="-fx-text-fill:#64748b;
                                      -fx-font-size:11px;"
                               text="You are signed in successfully."
                               wrapText="true"/>

                    </VBox>

                </HBox>


                <!-- SMALL ACCENT LINE -->

                <Region minHeight="3"
                        maxHeight="3"
                        style="-fx-background-color:#22c55e;
                               -fx-background-radius:3;"/>

            </VBox>

        </StackPane>

    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" minHeight="600" minWidth="900" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.student_management_system.Controller.Admin.AdminDashboardController">

    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <left>

        <VBox fillWidth="true" maxHeight="Infinity" maxWidth="260" minWidth="210" prefWidth="230" spacing="4" style="-fx-background-color: #172033;">

            <padding>
                <Insets bottom="18" left="14" right="14" top="25" />
            </padding>

            <!-- LOGO -->
            <VBox spacing="3" style="-fx-padding: 0 4 15 4;">
                <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="STUDENT" />
                <Label style="-fx-text-fill: #8e9ab0; -fx-font-size: 10px; -fx-font-weight: bold;" text="MANAGEMENT SYSTEM" />
            </VBox>

            <Label style="-fx-text-fill: #6f7d95; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 8 0 7 5;" text="MAIN MENU" />

            <!-- MENU -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" maxWidth="Infinity" minHeight="42" onAction="#refreshDashboard" prefHeight="42" style="-fx-background-color: #344563; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="⌂   Dashboard" />
                <Button fx:id="btnStudents" maxWidth="Infinity" minHeight="42" onAction="#openStudents" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="♙   Students" />
                <Button fx:id="btnTeachers" maxWidth="Infinity" minHeight="42" onAction="#openTeachers" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="♟   Teachers" />
                <Button fx:id="btnClasses" maxWidth="Infinity" minHeight="42" onAction="#openClasses" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="▣   Classes" />
                <Button fx:id="btnSubjects" maxWidth="Infinity" minHeight="42" onAction="#openSubjects" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="▤   Subjects" />
                <Button fx:id="btnExams" maxWidth="Infinity" minHeight="42" onAction="#openExams" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="✎   Exams" />
                <Button fx:id="btnGrades" maxWidth="Infinity" minHeight="42" onAction="#openGrades" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="▥   Grades / Results" />
                <Button fx:id="btnAttendance" maxWidth="Infinity" minHeight="42" onAction="#openAttendance" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="✓   Attendance" />
                <Button fx:id="btnLeave" maxWidth="Infinity" minHeight="42" onAction="#openLeaveRequests" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="✉   Leave Requests" />
                <Button fx:id="btnAnnouncements" maxWidth="Infinity" minHeight="42" onAction="#openAnnouncements" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="⚑   Announcements" />
                <Button fx:id="btnProfile" maxWidth="Infinity" minHeight="42" onAction="#openProfile" prefHeight="42" style="-fx-background-color: transparent; -fx-text-fill: #b2bdcf; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="⚙   Profile" />
            </VBox>

            <Button fx:id="btnLogout" maxWidth="Infinity" minHeight="42" onAction="#logout" prefHeight="42" style="-fx-background-color: #293750; -fx-text-fill: #ff8585; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-background-radius: 8; -fx-cursor: hand;" text="⇥   Logout" />

        </VBox>

    </left>

    <!-- ===================================================== -->
    <!-- CENTER -->
    <!-- ===================================================== -->

    <center>

        <StackPane fx:id="contentPane" maxHeight="Infinity" maxWidth="Infinity">

            <!-- ================================================= -->
            <!-- DASHBOARD -->
            <!-- ================================================= -->

            <ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" hbarPolicy="NEVER" maxHeight="Infinity" maxWidth="Infinity" pannable="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">

                <content>

                    <VBox fillWidth="true" maxWidth="Infinity" spacing="20" style="-fx-background-color: #f5f7fb;">

                        <padding>
                            <Insets bottom="35" left="30" right="30" top="28" />
                        </padding>

                        <!-- ================================================= -->
                        <!-- HEADER -->
                        <!-- ================================================= -->

                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="20">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #172033; -fx-font-size: 28px; -fx-font-weight: bold;" text="Dashboard" />
                                <Label style="-fx-text-fill: #8995aa; -fx-font-size: 14px;" text="Overview of your student management system" />
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="3">
                                <Label style="-fx-text-fill: #8995aa; -fx-font-size: 10px; -fx-font-weight: bold;" text="ADMINISTRATOR" />
                                <Label fx:id="lblAdminName" style="-fx-text-fill: #172033; -fx-font-size: 14px; -fx-font-weight: bold;" text="Kaung Min Khant" />
                            </VBox>
                        </HBox>

                        <!-- ================================================= -->
                        <!-- STATISTICS -->
                        <!-- ================================================= -->

                        <GridPane hgap="18" maxWidth="Infinity" vgap="18">
                            <columnConstraints>
                                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" percentWidth="25" />
                                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" percentWidth="25" />
                                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" percentWidth="25" />
                                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" percentWidth="25" />
                            </columnConstraints>

                            <VBox maxWidth="Infinity" minHeight="135" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),15,0,0,4);" GridPane.columnIndex="0">
                                <Label style="-fx-text-fill: #8995aa; -fx-font-size: 10px; -fx-font-weight: bold;" text="TOTAL STUDENTS" />
                                <Label fx:id="lblTotalStudents" style="-fx-text-fill: #172033; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-text-fill: #9aa5b7; -fx-font-size: 11px;" text="Active students" />
                            </VBox>

                            <VBox maxWidth="Infinity" minHeight="135" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),15,0,0,4);" GridPane.columnIndex="1">
                                <Label style="-fx-text-fill: #8995aa; -fx-font-size: 10px; -fx-font-weight: bold;" text="TOTAL TEACHERS" />
                                <Label fx:id="lblTotalTeachers" style="-fx-text-fill: #172033; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-text-fill: #9aa5b7; -fx-font-size: 11px;" text="Active teachers" />
                            </VBox>

                            <VBox maxWidth="Infinity" minHeight="135" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),15,0,0,4);" GridPane.columnIndex="2">
                                <Label style="-fx-text-fill: #8995aa; -fx-font-size: 10px; -fx-font-weight: bold;" text="TOTAL CLASSES" />
                                <Label fx:id="lblTotalClasses" style="-fx-text-fill: #172033; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-text-fill: #9aa5b7; -fx-font-size: 11px;" text="Active batches" />
                            </VBox>

                            <VBox maxWidth="Infinity" minHeight="135" spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),15,0,0,4);" GridPane.columnIndex="3">
                                <Label style="-fx-text-fill: #8995aa; -fx-font-size: 10px; -fx-font-weight: bold;" text="TOTAL SUBJECTS" />
                                <Label fx:id="lblTotalSubjects" style="-fx-text-fill: #172033; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-text-fill: #9aa5b7; -fx-font-size: 11px;" text="Available subjects" />
                            </VBox>

                            <rowConstraints>
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>

                        <!-- ================================================= -->
                        <!-- CHARTS -->
                        <!-- ================================================= -->

                        <GridPane hgap="20" maxWidth="Infinity">
                            <columnConstraints>
                                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints fillWidth="true" hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <!-- ================================================= -->
                            <!-- ATTENDANCE CARD -->
                            <!-- ================================================= -->

                            <VBox maxWidth="Infinity" minHeight="430" spacing="15" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),18,0,0,4);" GridPane.columnIndex="0">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #172033; -fx-font-size: 19px; -fx-font-weight: bold;" text="Attendance Overview" />
                                        <Label style="-fx-text-fill: #8995aa; -fx-font-size: 11px;" text="Attendance performance by batch" />
                                    </VBox>
                                </HBox>

                                <!-- FILTERS -->
                                <HBox spacing="10" VBox.vgrow="NEVER">
                                    <ComboBox fx:id="cmbAttendancePeriod" prefHeight="36" prefWidth="125" promptText="Period" style="-fx-background-radius: 9; -fx-border-radius: 9; -fx-border-color: #e4e8ef;" />
                                    <ComboBox fx:id="cmbAttendanceBatch" prefHeight="36" promptText="Batch" style="-fx-background-radius: 9; -fx-border-radius: 9; -fx-border-color: #e4e8ef;" HBox.hgrow="ALWAYS" />
                                </HBox>

                                <!-- PIE : fixed height so it always matches the exam chart regardless of how many filter rows sit above it -->
                                <StackPane maxWidth="Infinity" minHeight="320" prefHeight="320" maxHeight="320" VBox.vgrow="NEVER">
                                    <PieChart fx:id="attendancePieChart" animated="true" labelsVisible="true" legendSide="RIGHT" maxHeight="320" maxWidth="Infinity" minHeight="320" prefHeight="320" prefWidth="500" startAngle="90" styleClass="dashboard-pie-chart" />
                                </StackPane>

                            </VBox>

                            <!-- ================================================= -->
                            <!-- EXAM CARD -->
                            <!-- ================================================= -->

                            <VBox maxWidth="Infinity" minHeight="430" spacing="15" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),18,0,0,4);" GridPane.columnIndex="1">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #172033; -fx-font-size: 19px; -fx-font-weight: bold;" text="Exam Results" />
                                        <Label style="-fx-text-fill: #8995aa; -fx-font-size: 11px;" text="Pass and fail performance by exam" />
                                    </VBox>
                                </HBox>

                                <!-- EXAM FILTER: same-height HBox wrapper as the attendance filter row, so both cards
                                     reserve identical vertical space above the chart even though this card only has
                                     one dropdown -->
                                <HBox spacing="10" VBox.vgrow="NEVER">
                                    <ComboBox fx:id="cmbExam" maxWidth="Infinity" prefHeight="36" promptText="Select Exam" style="-fx-background-radius: 9; -fx-border-radius: 9; -fx-border-color: #e4e8ef;" HBox.hgrow="ALWAYS" />
                                </HBox>

                                <!-- EXAM PIE : same fixed height and legend style as the attendance pie above -->
                                <StackPane maxWidth="Infinity" minHeight="320" prefHeight="320" maxHeight="320" VBox.vgrow="NEVER">
                                    <PieChart fx:id="examPieChart" animated="true" labelsVisible="true" legendSide="RIGHT" maxHeight="320" maxWidth="Infinity" minHeight="320" prefHeight="320" prefWidth="500" startAngle="90" styleClass="dashboard-pie-chart" />
                                </StackPane>

                            </VBox>

                            <rowConstraints>
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>

                        <!-- ================================================= -->
                        <!-- STUDENTS BY BATCH (replaces "Recent Students") -->
                        <!-- ================================================= -->

                        <VBox maxWidth="Infinity" spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07),15,0,0,4);">

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #172033; -fx-font-size: 18px; -fx-font-weight: bold;" text="Students by Batch" />
                                    <Label style="-fx-text-fill: #8995aa; -fx-font-size: 11px;" text="Browse students grouped by batch" />
                                </VBox>

                                <ComboBox fx:id="cmbStudentsBatch" prefHeight="36" prefWidth="220" promptText="All Batches" style="-fx-background-radius: 9; -fx-border-radius: 9; -fx-border-color: #e4e8ef;" />

                                <Button onAction="#refreshDashboard" prefHeight="34" style="-fx-background-color: #edf3ff; -fx-text-fill: #4267d5; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 15; -fx-cursor: hand;" text="⟳  Refresh" />
                            </HBox>

                            <TableView fx:id="studentTable" maxWidth="Infinity" minHeight="150" prefHeight="220">
                                <columns>
                                    <TableColumn fx:id="studentCodeColumn" prefWidth="180" text="Student Code" />
                                    <TableColumn fx:id="studentNameColumn" prefWidth="240" text="Student Name" />
                                    <TableColumn fx:id="studentEmailColumn" prefWidth="300" text="Email" />
                                    <TableColumn fx:id="studentBatchColumn" prefWidth="150" text="Batch" />
                                    <TableColumn fx:id="studentStatusColumn" prefWidth="120" text="Status" />
                                </columns>
                            </TableView>

                        </VBox>

                        <!-- ================================================= -->
                        <!-- LEAVE -->
                        <!-- ================================================= -->

                        <VBox maxWidth="Infinity" spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07),15,0,0,4);">

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #172033; -fx-font-size: 18px; -fx-font-weight: bold;" text="Pending Leave Requests" />
                                    <Label style="-fx-text-fill: #8995aa; -fx-font-size: 11px;" text="Students waiting for approval" />
                                </VBox>

                                <ComboBox fx:id="cmbLeaveBatch" prefHeight="36" prefWidth="220" promptText="All Batches" style="-fx-background-radius: 9; -fx-border-radius: 9; -fx-border-color: #e4e8ef;" />
                            </HBox>

                            <TableView fx:id="leaveTable" maxWidth="Infinity" minHeight="150" prefHeight="190">
                                <columns>
                                    <TableColumn fx:id="leaveStudentColumn" prefWidth="240" text="Student" />
                                    <TableColumn fx:id="leaveBatchColumn" prefWidth="160" text="Batch" />
                                    <TableColumn fx:id="leaveFromColumn" prefWidth="170" text="Leave From" />
                                    <TableColumn fx:id="leaveToColumn" prefWidth="170" text="Leave To" />
                                    <TableColumn fx:id="leaveStatusColumn" prefWidth="150" text="Status" />
                                </columns>
                            </TableView>

                        </VBox>

                        <Region minHeight="20" prefHeight="20" />

                    </VBox>

                </content>

            </ScrollPane>

            <!-- ================================================= -->
            <!-- OTHER PAGES -->
            <!-- ================================================= -->

            <AnchorPane fx:id="adminPane" maxHeight="Infinity" maxWidth="Infinity" visible="false" />

        </StackPane>

    </center>

</BorderPane>

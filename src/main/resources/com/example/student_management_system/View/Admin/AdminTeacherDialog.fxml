<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Admin.AddTeacherDialogController"
            style="-fx-background-color: #f6f8fc;">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                style="-fx-background-color: transparent;">
        <content>
            <VBox spacing="18" style="-fx-padding: 24;">

                <!-- HEADER -->
                <VBox spacing="4">
                    <Label fx:id="lblDialogTitle" text="Add New Teacher"
                           style="-fx-text-fill:#172033;-fx-font-size:22px;-fx-font-weight:bold;"/>
                    <Label fx:id="lblDialogSubtitle" text="Create a teacher account and profile"
                           style="-fx-text-fill:#8995aa;-fx-font-size:13px;"/>
                </VBox>

                <!-- PHOTO CARD -->
                <VBox spacing="12"
                      style="-fx-background-color:white;-fx-background-radius:14;-fx-padding:18;
                             -fx-border-color:#e8edf5;-fx-border-radius:14;">

                    <Label text="PROFILE PHOTO"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <StackPane minHeight="80" minWidth="80" maxHeight="80" maxWidth="80"
                                   style="-fx-background-color:#eef2ff;-fx-background-radius:40;">
                            <Circle fx:id="photoPlaceholderCircle" radius="40" fill="#eef2ff"/>
                            <ImageView fx:id="photoPreview"
                                       fitHeight="80" fitWidth="80" preserveRatio="false"
                                       visible="false">
                                <clip>
                                    <Circle radius="40" centerX="40" centerY="40"/>
                                </clip>
                            </ImageView>
                        </StackPane>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Button fx:id="btnChoosePhoto" onAction="#choosePhoto"
                                    text="Choose Photo"
                                    prefHeight="36" minWidth="150"
                                    style="-fx-background-color:#eef2ff;-fx-text-fill:#4f46e5;
                                           -fx-background-radius:9;-fx-font-size:12px;-fx-font-weight:bold;
                                           -fx-padding:0 20;-fx-cursor:hand;
                                           -fx-border-color:#c7d2fe;-fx-border-radius:9;"/>
                            <Label fx:id="lblPhotoFileName" text="No photo selected"
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                            <Label fx:id="lblPhotoError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ACCOUNT CARD -->
                <VBox spacing="12"
                      style="-fx-background-color:white;-fx-background-radius:14;-fx-padding:18;
                             -fx-border-color:#e8edf5;-fx-border-radius:14;">

                    <Label text="ACCOUNT"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                    <!-- Full name + Teacher code -->
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Full name"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <TextField fx:id="txtFullName" prefHeight="36"
                                       promptText="e.g. John Smith"/>
                            <Label fx:id="lblFullNameError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Teacher code"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <TextField fx:id="txtTeacherCode" prefHeight="36"
                                       promptText="e.g. T001"/>
                            <Label fx:id="lblTeacherCodeError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Username -->
                    <VBox spacing="4">
                        <Label text="Username"
                               style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                        <TextField fx:id="txtUsername" prefHeight="36"
                                   promptText="e.g. jsmith"/>
                        <Label fx:id="lblUsernameError" text="" visible="false" managed="false"
                               wrapText="true"
                               style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                    </VBox>

                    <!-- Password + Confirm -->
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Password"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <StackPane prefHeight="36">
                                <PasswordField fx:id="txtPassword" prefHeight="36"
                                               promptText="Enter password"
                                               style="-fx-padding:0 40 0 10; -fx-background-radius:8;"/>
                                <TextField fx:id="visiblePasswordField"
                                           prefHeight="36" visible="false" managed="false"
                                           promptText="Enter password"
                                           style="-fx-padding:0 40 0 10; -fx-background-radius:8;"/>
                                <Button fx:id="btnEye"
                                        onAction="#togglePasswordVisibility"
                                        StackPane.alignment="CENTER_RIGHT"
                                        translateX="-6"
                                        maxHeight="26" minHeight="26" maxWidth="26" minWidth="26"
                                        focusTraversable="false"
                                        style="-fx-background-color:transparent;-fx-padding:0;-fx-cursor:hand;">
                                    <graphic>
                                        <FontIcon fx:id="eyeIcon" iconLiteral="fas-eye"
                                                  iconSize="14" iconColor="#64748b"/>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="lblPasswordHint" text="Minimum 8 characters"
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                            <Label fx:id="lblPasswordError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>

                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Confirm password"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <StackPane prefHeight="36">
                                <PasswordField fx:id="txtConfirmPassword" prefHeight="36"
                                               promptText="Re-enter password"
                                               style="-fx-padding:0 40 0 10; -fx-background-radius:8;"/>
                                <TextField fx:id="visibleConfirmPasswordField"
                                           prefHeight="36" visible="false" managed="false"
                                           promptText="Re-enter password"
                                           style="-fx-padding:0 40 0 10; -fx-background-radius:8;"/>
                                <Button fx:id="btnConfirmEye"
                                        onAction="#toggleConfirmPasswordVisibility"
                                        StackPane.alignment="CENTER_RIGHT"
                                        translateX="-6"
                                        maxHeight="26" minHeight="26" maxWidth="26" minWidth="26"
                                        focusTraversable="false"
                                        style="-fx-background-color:transparent;-fx-padding:0;-fx-cursor:hand;">
                                    <graphic>
                                        <FontIcon fx:id="confirmEyeIcon" iconLiteral="fas-eye"
                                                  iconSize="14" iconColor="#64748b"/>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="lblConfirmPasswordError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="lblPasswordRules"
                           text="8+ chars, one uppercase, one lowercase, one number, one special."
                           wrapText="true"
                           style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                </VBox>

                <!-- PROFILE CARD -->
                <VBox spacing="12"
                      style="-fx-background-color:white;-fx-background-radius:14;-fx-padding:18;
                             -fx-border-color:#e8edf5;-fx-border-radius:14;">

                    <Label text="PROFILE"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                    <!--
                    Email + Phone -->
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Email"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <TextField fx:id="txtEmail" prefHeight="36"
                                       promptText="teacher@school.com"/>
                            <Label fx:id="lblEmailError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Phone"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <TextField fx:id="txtPhone" prefHeight="36"
                                       promptText="09xxxxxxxxx"/>
                            <Label fx:id="lblPhoneError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Gender + Hire date + Salary -->
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Gender"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <ComboBox fx:id="cmbGender" prefHeight="36" maxWidth="Infinity"
                                      promptText="Select gender"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Hire date"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <DatePicker fx:id="dpHireDate" prefHeight="36" maxWidth="Infinity"/>
                            <Label fx:id="lblHireDateError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Salary (MMK)"
                                   style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <TextField fx:id="txtSalary" prefHeight="36"
                                       promptText="e.g. 750000"/>
                            <Label fx:id="lblSalaryError" text="" visible="false" managed="false"
                                   wrapText="true"
                                   style="-fx-text-fill:#dc2626;-fx-font-size:11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Class leader -->
                    <VBox spacing="4">
                        <Label text="Class leader of"
                               style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                        <ComboBox fx:id="cmbClassLeaderOf" prefHeight="36" maxWidth="Infinity"
                                  promptText="Select a class (or None)"/>
                    </VBox>

                    <!-- Address -->
                    <VBox spacing="4">
                        <Label text="Address"
                               style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                        <TextArea fx:id="txtAddress" prefRowCount="3" wrapText="true"
                                  promptText="Optional address"/>
                    </VBox>

                    <!-- Subjects taught -->
                    <VBox spacing="6">
                        <Label text="Subjects taught"
                               style="-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:bold;"/>
                        <VBox fx:id="subjectsBox" spacing="4"
                              style="-fx-background-color:#f8fafc;-fx-background-radius:10;-fx-padding:12;"/>
                    </VBox>
                </VBox>

                <!-- ACTIONS -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnCancel" onAction="#cancel" text="Cancel"
                            prefHeight="40" minWidth="110"
                            style="-fx-background-color:#f0f2f6;-fx-text-fill:#344563;
                                   -fx-background-radius:9;-fx-font-size:12px;-fx-font-weight:bold;
                                   -fx-padding:0 20;-fx-cursor:hand;"/>
                    <Button fx:id="btnSave" onAction="#save" text="Save Teacher"
                            prefHeight="40" minWidth="160"
                            style="-fx-background-color:#2563EB;-fx-text-fill:white;
                                   -fx-background-radius:9;-fx-font-size:12px;-fx-font-weight:bold;
                                   -fx-padding:0 22;-fx-cursor:hand;"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox maxWidth="Infinity"
      maxHeight="Infinity"
      prefWidth="620"
      prefHeight="760"
      minWidth="460"
      minHeight="600"
      spacing="0"
      fillWidth="true"
      style="-fx-background-color: #f5f7fb;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.student_management_system.Controller.Admin.AddTeacherDialogController">

    <!-- HEADER -->
    <VBox spacing="5"
          fillWidth="true"
          style="-fx-background-color: white;
                 -fx-padding: 22 26;">

        <Label fx:id="lblDialogTitle"
               text="Add New Teacher"
               style="-fx-text-fill: #172033;
                      -fx-font-size: 20px;
                      -fx-font-weight: bold;"/>

        <Label fx:id="lblDialogSubtitle"
               text="Create a teacher account and profile"
               wrapText="true"
               style="-fx-text-fill: #8995aa;
                      -fx-font-size: 12px;"/>
    </VBox>

    <!-- SCROLLABLE FORM AREA -->
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                maxWidth="Infinity"
                maxHeight="Infinity"
                style="-fx-background-color: transparent;
                       -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">

        <content>

            <VBox maxWidth="Infinity"
                  fillWidth="true"
                  spacing="18"
                  style="-fx-padding: 22 26;">

                <!-- PHOTO -->
                <HBox alignment="CENTER_LEFT"
                      spacing="16"
                      maxWidth="Infinity">

                    <StackPane prefHeight="72"
                               prefWidth="72"
                               minHeight="72"
                               minWidth="72">

                        <Circle fx:id="photoPlaceholderCircle"
                                radius="36"
                                fill="#e4e8ef"/>

                        <ImageView fx:id="photoPreview"
                                   fitHeight="72"
                                   fitWidth="72"
                                   pickOnBounds="true"
                                   preserveRatio="false"
                                   visible="false"/>
                    </StackPane>

                    <VBox spacing="6"
                          fillWidth="true"
                          HBox.hgrow="ALWAYS">

                        <Button fx:id="btnChoosePhoto"
                                onAction="#choosePhoto"
                                text="Choose Photo"
                                maxWidth="Infinity"
                                style="-fx-background-color: #edf3ff;
                                       -fx-text-fill: #4267d5;
                                       -fx-font-size: 12px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-padding: 8 14;
                                       -fx-cursor: hand;"/>

                        <Label fx:id="lblPhotoFileName"
                               text="No photo selected"
                               wrapText="true"
                               style="-fx-text-fill: #8995aa;
                                      -fx-font-size: 11px;"/>

                        <Label fx:id="lblPhotoError"
                               visible="false"
                               managed="false"
                               wrapText="true"
                               style="-fx-text-fill: #e5484d;
                                      -fx-font-size: 11px;
                                      -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- FULL NAME -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Full Name *"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtFullName"
                               maxWidth="Infinity"
                               promptText="e.g. John Smith"/>

                    <Label fx:id="lblFullNameError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- TEACHER CODE -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Teacher Code"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtTeacherCode"
                               maxWidth="Infinity"
                               promptText="e.g. T004"/>

                    <Label fx:id="lblTeacherCodeError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- USERNAME -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Username *"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtUsername"
                               maxWidth="Infinity"
                               promptText="Login username"/>

                    <Label fx:id="lblUsernameError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- PASSWORD -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Password *"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <PasswordField fx:id="txtPassword"
                                   maxWidth="Infinity"
                                   promptText="Login password"/>

                    <Label fx:id="lblPasswordHint"
                           text="Minimum 8 characters"
                           style="-fx-text-fill: #8995aa;
                                  -fx-font-size: 10px;"/>

                    <Label fx:id="lblPasswordRules"
                           text="Must contain uppercase, lowercase, number, and special character"
                           wrapText="true"
                           style="-fx-text-fill: #8995aa;
                                  -fx-font-size: 10px;"/>

                    <Label fx:id="lblPasswordError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- CONFIRM PASSWORD -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Confirm Password *"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <PasswordField fx:id="txtConfirmPassword"
                                   maxWidth="Infinity"
                                   promptText="Repeat password"/>

                    <Label fx:id="lblConfirmPasswordError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- EMAIL -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Email"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtEmail"
                               maxWidth="Infinity"
                               promptText="teacher@gmail.com"/>

                    <Label fx:id="lblEmailError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- PHONE -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Phone"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtPhone"
                               maxWidth="Infinity"
                               promptText="09xxxxxxxxx"/>

                    <Label fx:id="lblPhoneError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- GENDER -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Gender"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <ComboBox fx:id="cmbGender"
                              maxWidth="Infinity"
                              promptText="Select"/>
                </VBox>

                <!-- HIRE DATE -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Hire Date"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <DatePicker fx:id="dpHireDate"
                                maxWidth="Infinity"/>

                    <Label fx:id="lblHireDateError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- SALARY -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Salary (MMK / month)"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtSalary"
                               maxWidth="Infinity"
                               promptText="e.g. 750000"/>

                    <Label fx:id="lblSalaryError"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #e5484d;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- CLASS LEADER -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Class Leader Of"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <ComboBox fx:id="cmbClassLeaderOf"
                              maxWidth="Infinity"
                              promptText="None"/>
                </VBox>

                <!-- ADDRESS -->
                <VBox spacing="5"
                      fillWidth="true">

                    <Label text="Address"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <TextArea fx:id="txtAddress"
                              maxWidth="Infinity"
                              prefRowCount="3"
                              wrapText="true"/>
                </VBox>

                <!-- SUBJECTS -->
                <VBox spacing="8"
                      fillWidth="true">

                    <Label text="Subjects Teaching"
                           style="-fx-text-fill: #5b6b85;
                                  -fx-font-size: 11px;
                                  -fx-font-weight: bold;"/>

                    <VBox fx:id="subjectsBox"
                          maxWidth="Infinity"
                          spacing="6"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 12;
                                 -fx-border-color: #e4e8ef;
                                 -fx-border-radius: 10;"/>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- FIXED FOOTER -->
    <HBox alignment="CENTER_RIGHT"
          minHeight="72"
          prefHeight="72"
          maxHeight="72"
          spacing="10"
          style="-fx-background-color: white;
                 -fx-padding: 14 26;
                 -fx-border-color: #eef1f6 transparent transparent transparent;
                 -fx-border-width: 1 0 0 0;">

        <Button fx:id="btnCancel"
                onAction="#cancel"
                minWidth="95"
                text="Cancel"
                style="-fx-background-color: #f0f2f6;
                       -fx-text-fill: #344563;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10 20;
                       -fx-cursor: hand;"/>

        <Button fx:id="btnSave"
                defaultButton="true"
                onAction="#save"
                minWidth="125"
                text="Save Teacher"
                style="-fx-background-color: #2563EB;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10 22;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>
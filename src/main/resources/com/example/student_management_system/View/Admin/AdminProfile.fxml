<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.Admin.AdminProfileController"
           style="-fx-background-color:#f6f8fc;">

    <AnchorPane>
        <VBox spacing="20"
              AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <padding><Insets top="28" right="30" bottom="30" left="30"/></padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="My Profile"
                           style="-fx-text-fill:#0f172a;-fx-font-size:28px;-fx-font-weight:bold;"/>
                    <Label text="Manage your account details, photo, and password."
                           style="-fx-text-fill:#64748b;-fx-font-size:13px;"/>
                </VBox>
            </HBox>

            <!-- MAIN -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">

                <!-- LEFT: profile summary -->
                <VBox prefWidth="330" minWidth="300" spacing="16"
                      style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:22;
                             -fx-border-color:#e8edf5;-fx-border-radius:18;">

                    <StackPane minHeight="110" minWidth="110" maxHeight="110" maxWidth="110"
                               style="-fx-background-color:#eef2ff;-fx-background-radius:55;">
                        <ImageView fx:id="imgProfilePhoto"
                                   fitHeight="110" fitWidth="110" preserveRatio="false">
                            <clip><Circle radius="55" centerX="55" centerY="55"/></clip>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="lblDisplayName" text="Admin"
                               style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>
                        <Label fx:id="lblUsername" text="Username: --"
                               style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>
                        <Label fx:id="lblRole" text="Administrator"
                               style="-fx-text-fill:#2F6F5E;-fx-font-size:11px;-fx-font-weight:bold;"/>
                    </VBox>

                    <Region minHeight="1" style="-fx-background-color:#eef2ff;"/>

                    <Button fx:id="btnChoosePhoto"
                            onAction="#handleChoosePhoto"
                            prefHeight="36" maxWidth="Infinity"
                            style="-fx-background-color:#eef2ff;-fx-text-fill:#2F6F5E;
                                   -fx-background-radius:9;-fx-font-size:12px;-fx-font-weight:bold;
                                   -fx-cursor:hand;-fx-border-color:#c7d2fe;-fx-border-radius:9;"
                            text="Change Photo"/>

                    <Label text="JPG or PNG. Square images work best."
                           wrapText="true" textAlignment="CENTER"
                           style="-fx-text-fill:#94a3b8;-fx-font-size:10px;"/>

                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- RIGHT: forms -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <!-- Update Account card -->
                    <VBox spacing="14"
                          style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:22;
                                 -fx-border-color:#e8edf5;-fx-border-radius:18;">

                        <VBox spacing="3">
                            <Label text="Account Details"
                                   style="-fx-text-fill:#0f172a;-fx-font-size:16px;-fx-font-weight:bold;"/>
                            <Label text="Update your name and username."
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="FULL NAME"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                                <TextField fx:id="txtFullName" prefHeight="38"
                                           promptText="e.g. Kaung Min Khant"/>
                            </VBox>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="USERNAME"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                                <TextField fx:id="txtUsername" prefHeight="38"
                                           promptText="e.g. admin"/>
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button onAction="#handleSaveProfile"
                                    prefHeight="40" minWidth="180"
                                    style="-fx-background-color:linear-gradient(to right,#2F6F5E,#3F8A76);
                                           -fx-text-fill:white;-fx-background-radius:10;
                                           -fx-font-size:12px;-fx-font-weight:bold;
                                           -fx-padding:0 26;-fx-cursor:hand;
                                           -fx-effect:dropshadow(gaussian,rgba(47,111,94,.35),10,0,0,3);"
                                    text="Save Changes"/>
                        </HBox>
                    </VBox>

                    <!-- Change Password card -->
                    <VBox spacing="14" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:22;
                                 -fx-border-color:#e8edf5;-fx-border-radius:18;">

                        <VBox spacing="3">
                            <Label text="Change Password"
                                   style="-fx-text-fill:#0f172a;-fx-font-size:16px;-fx-font-weight:bold;"/>
                            <Label text="Choose a strong password that meets all rules."
                                   style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                        </VBox>

                        <HBox spacing="14">
                            <!-- CURRENT password -->
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="CURRENT PASSWORD"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                                <StackPane prefHeight="40">
                                    <PasswordField fx:id="txtOldPassword"
                                                   prefHeight="40"
                                                   style="-fx-padding:0 44 0 12; -fx-background-radius:9;"
                                                   promptText="Enter current password"/>

                                    <TextField fx:id="visibleOldPassword"
                                               prefHeight="40"
                                               visible="false" managed="false"
                                               style="-fx-padding:0 44 0 12; -fx-background-radius:9;"
                                               promptText="Enter current password"/>

                                    <Button fx:id="btnOldPasswordEye"
                                            onAction="#toggleOldPasswordVisibility"
                                            maxHeight="26" minHeight="26"
                                            maxWidth="26" minWidth="26"
                                            StackPane.alignment="CENTER_RIGHT"
                                            translateX="-8"
                                            focusTraversable="false"
                                            style="-fx-background-color:transparent;
                                                   -fx-text-fill:#64748b;
                                                   -fx-font-size:14px;
                                                   -fx-cursor:hand;
                                                   -fx-padding:0;
                                                   -fx-border-color:transparent;"
                                            text="👁"/>
                                </StackPane>
                            </VBox>

                            <!-- NEW password -->
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="NEW PASSWORD"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                                <StackPane prefHeight="40">
                                    <PasswordField fx:id="txtNewPassword"
                                                   prefHeight="40"
                                                   style="-fx-padding:0 44 0 12; -fx-background-radius:9;"
                                                   promptText="Enter new password"/>

                                    <TextField fx:id="visibleNewPassword"
                                               prefHeight="40"
                                               visible="false" managed="false"
                                               style="-fx-padding:0 44 0 12; -fx-background-radius:9;"
                                               promptText="Enter new password"/>

                                    <Button fx:id="btnNewPasswordEye"
                                            onAction="#toggleNewPasswordVisibility"
                                            maxHeight="26" minHeight="26"
                                            maxWidth="26" minWidth="26"
                                            StackPane.alignment="CENTER_RIGHT"
                                            translateX="-8"
                                            focusTraversable="false"
                                            style="-fx-background-color:transparent;
                                                   -fx-text-fill:#64748b;
                                                   -fx-font-size:14px;
                                                   -fx-cursor:hand;
                                                   -fx-padding:0;
                                                   -fx-border-color:transparent;"
                                            text="👁"/>
                                </StackPane>
                            </VBox>

                            <!-- CONFIRM password -->
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="CONFIRM NEW PASSWORD"
                                       style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                                <StackPane prefHeight="40">
                                    <PasswordField fx:id="txtConfirmPassword"
                                                   prefHeight="40"
                                                   style="-fx-padding:0 44 0 12; -fx-background-radius:9;"
                                                   promptText="Re-enter new password"/>

                                    <TextField fx:id="visibleConfirmPassword"
                                               prefHeight="40"
                                               visible="false" managed="false"
                                               style="-fx-padding:0 44 0 12; -fx-background-radius:9;"
                                               promptText="Re-enter new password"/>

                                    <Button fx:id="btnConfirmPasswordEye"
                                            onAction="#toggleConfirmPasswordVisibility"
                                            maxHeight="26" minHeight="26"
                                            maxWidth="26" minWidth="26"
                                            StackPane.alignment="CENTER_RIGHT"
                                            translateX="-8"
                                            focusTraversable="false"
                                            style="-fx-background-color:transparent;
                                                   -fx-text-fill:#64748b;
                                                   -fx-font-size:14px;
                                                   -fx-cursor:hand;
                                                   -fx-padding:0;
                                                   -fx-border-color:transparent;"
                                            text="👁"/>
                                </StackPane>
                            </VBox>
                        </HBox>

                        <!-- Live rule checklist -->
                        <VBox spacing="4"
                              style="-fx-background-color:#f8fafc;-fx-background-radius:11;-fx-padding:12;">
                            <Label text="PASSWORD RULES"
                                   style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                            <GridPane hgap="20" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>
                                <Label fx:id="ruleLength"  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="ruleUpper"   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label fx:id="ruleLower"   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="ruleSpecial" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            </GridPane>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button onAction="#handleChangePassword"
                                    prefHeight="42" minWidth="180"
                                    style="-fx-background-color:linear-gradient(to right,#2F6F5E,#3F8A76);
                                           -fx-text-fill:white;-fx-background-radius:10;
                                           -fx-font-size:12px;-fx-font-weight:bold;
                                           -fx-padding:0 26;-fx-cursor:hand;
                                           -fx-effect:dropshadow(gaussian,rgba(47,111,94,.35),10,0,0,3);"
                                    text="Update Password"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </AnchorPane>

    <!-- TOAST -->
    <VBox fx:id="adminProfileToast" managed="false" visible="false"
          maxWidth="420" prefWidth="420" spacing="8"
          translateX="-24" translateY="24" StackPane.alignment="TOP_RIGHT"
          style="-fx-background-color:white; -fx-background-radius:15;
                 -fx-padding:15 17 15 15; -fx-border-color:#e2e8f0; -fx-border-radius:15;
                 -fx-effect:dropshadow(gaussian,rgba(15,23,42,.20),22,0,0,6);">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="toast-icon" minHeight="38" minWidth="38"
                       style="-fx-background-color:#dcfce7; -fx-background-radius:19;">
                <Label styleClass="toast-icon-label" text="✓"
                       style="-fx-text-fill:#16a34a; -fx-font-size:17px; -fx-font-weight:bold;"/>
            </StackPane>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label fx:id="lblToastTitle" text="UPDATE SUCCESSFUL"
                       style="-fx-text-fill:#64748b;-fx-font-size:9px;-fx-font-weight:bold;"/>
                <Label fx:id="lblToastHeading" text="Success"
                       style="-fx-text-fill:#0f172a;-fx-font-size:14px;-fx-font-weight:bold;"/>
                <Label fx:id="lblToastMessage" text="Update complete." wrapText="true"
                       style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>
            </VBox>
        </HBox>
        <Region styleClass="toast-bar" maxHeight="3" minHeight="3"
                style="-fx-background-color:#22c55e; -fx-background-radius:3;"/>
    </VBox>

</StackPane>
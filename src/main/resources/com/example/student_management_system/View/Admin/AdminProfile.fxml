<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: #F7F8FA; -fx-background: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Admin.AdminProfileController">

    <content>
        <VBox style="-fx-background-color: #F7F8FA;" spacing="24.0">
            <padding>
                <Insets top="28" right="32" bottom="32" left="32"/>
            </padding>

            <!-- Header Section -->
            <VBox spacing="4.0">
                <Label text="Admin profile"
                       style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #1E2433; -fx-font-family: 'Segoe UI Semibold';"/>
                <Label text="Manage your account details, profile photo, and password."
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
            </VBox>

            <!-- Feedback Message Container -->
            <Label fx:id="lblMessage" wrapText="true" visible="false" managed="false"
                   style="-fx-padding: 10 14; -fx-background-radius: 8; -fx-font-size: 13px;"/>

            <!-- Main Content Container -->
            <HBox spacing="28.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                <!-- Fully Responsive Profile Photo Sidebar -->
                <VBox spacing="20.0" alignment="TOP_CENTER"
                      prefWidth="240.0" minWidth="200.0" maxWidth="280.0"
                      HBox.hgrow="NEVER" VBox.vgrow="NEVER"
                      style="-fx-background-color: linear-gradient(to bottom right, #2F6F5E, #23493D); -fx-background-radius: 16; -fx-padding: 28 20 28 20;">

                    <StackPane alignment="CENTER" VBox.vgrow="NEVER"
                               style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 16; -fx-border-width: 1.5; -fx-padding: 8;">
                        <StackPane alignment="CENTER" prefWidth="130.0" prefHeight="130.0" minWidth="100.0" minHeight="100.0" maxWidth="150.0" maxHeight="150.0">
                            <Circle radius="60.0" fill="transparent"/>
                            <ImageView fx:id="imgProfilePhoto"
                                       fitWidth="120.0" fitHeight="120.0"
                                       preserveRatio="true" smooth="true">
                                <clip>
                                    <Circle radius="60.0" centerX="60.0" centerY="60.0"/>
                                </clip>
                            </ImageView>
                        </StackPane>
                    </StackPane>

                    <VBox spacing="10.0" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Button fx:id="btnChoosePhoto" text="Change photo" onAction="#handleChoosePhoto" maxWidth="180.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-border-color: rgba(255,255,255,0.55); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-font-size: 12px; -fx-font-weight: 600; -fx-cursor: hand;"/>

                        <Label text="JPG or PNG, square images work best." maxWidth="180.0" wrapText="true" textAlignment="CENTER"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.70);"/>
                    </VBox>
                </VBox>

                <!-- Profile Details & Security Form Container -->
                <VBox spacing="24.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 28;">

                    <!-- Profile Details Section -->
                    <VBox spacing="16.0">
                        <Label text="Profile details" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1E2433;"/>

                        <HBox spacing="16.0" HBox.hgrow="ALWAYS">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label text="Full name" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4B5563;"/>
                                <TextField fx:id="txtFullName" promptText="Enter full name" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #E1E4EA; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12; -fx-font-size: 13px;"/>
                            </VBox>
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label text="Username" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4B5563;"/>
                                <TextField fx:id="txtUsername" promptText="Enter username" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #FFFFFF; -fx-border-color: #E1E4EA; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12; -fx-font-size: 13px;"/>
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="btnSaveProfile" text="Save changes" onAction="#handleSaveProfile"
                                    style="-fx-background-color: #2F6F5E; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 22 10 22; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <Separator style="-fx-background-color: #E4E7EC;"/>

                    <!-- Security / Change Password Section -->
                    <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                        <VBox spacing="2.0">
                            <Label text="Security" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1E2433;"/>
                            <Label text="Use 8+ characters with an uppercase letter, a lowercase letter, and a special character."
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                        </VBox>

                        <VBox spacing="14.0" HBox.hgrow="ALWAYS">

                            <!-- Current Password Field -->
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label text="Current password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4B5563;"/>
                                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-border-color: #E1E4EA; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-background-radius: 8;">

                                    <StackPane HBox.hgrow="ALWAYS">
                                        <PasswordField fx:id="txtOldPassword"
                                                       promptText="Enter current password"
                                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 9 12 9 12;"/>
                                        <TextField fx:id="visibleOldPassword"
                                                   managed="false" visible="false"
                                                   promptText="Enter current password"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 9 12 9 12;"/>
                                    </StackPane>

                                    <Button fx:id="btnOldPasswordEye"
                                            minWidth="40" minHeight="38"
                                            onAction="#toggleOldPasswordVisibility"
                                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                                        <graphic>
                                            <FontIcon fx:id="oldPasswordEyeIcon"
                                                      iconLiteral="fas-eye"
                                                      iconSize="15"
                                                      iconColor="#64748b"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                            </VBox>

                            <!-- New Password Field -->
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label text="New password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4B5563;"/>
                                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-border-color: #E1E4EA; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-background-radius: 8;">

                                    <StackPane HBox.hgrow="ALWAYS">
                                        <PasswordField fx:id="txtNewPassword"
                                                       promptText="Enter new password"
                                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 9 12 9 12;"/>
                                        <TextField fx:id="visibleNewPassword"
                                                   managed="false" visible="false"
                                                   promptText="Enter new password"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 9 12 9 12;"/>
                                    </StackPane>

                                    <Button fx:id="btnNewPasswordEye"
                                            minWidth="40" minHeight="38"
                                            onAction="#toggleNewPasswordVisibility"
                                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                                        <graphic>
                                            <FontIcon fx:id="newPasswordEyeIcon"
                                                      iconLiteral="fas-eye"
                                                      iconSize="15"
                                                      iconColor="#64748b"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                            </VBox>

                            <!-- Confirm Password Field -->
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <Label text="Confirm new password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4B5563;"/>
                                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #FFFFFF; -fx-border-color: #E1E4EA; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-background-radius: 8;">

                                    <StackPane HBox.hgrow="ALWAYS">
                                        <PasswordField fx:id="txtConfirmPassword"
                                                       promptText="Confirm new password"
                                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 9 12 9 12;"/>
                                        <TextField fx:id="visibleConfirmPassword"
                                                   managed="false" visible="false"
                                                   promptText="Confirm new password"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-padding: 9 12 9 12;"/>
                                    </StackPane>

                                    <Button fx:id="btnConfirmPasswordEye"
                                            minWidth="40" minHeight="38"
                                            onAction="#toggleConfirmPasswordVisibility"
                                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                                        <graphic>
                                            <FontIcon fx:id="confirmPasswordEyeIcon"
                                                      iconLiteral="fas-eye"
                                                      iconSize="15"
                                                      iconColor="#64748b"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                            </VBox>

                        </VBox>

                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="btnChangePassword" text="Update password" onAction="#handleChangePassword"
                                    style="-fx-background-color: #2F6F5E; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 22 10 22; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
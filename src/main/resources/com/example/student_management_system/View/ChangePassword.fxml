<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="500" prefWidth="440"
           style="-fx-background-color:#f8fafc;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.ChangePasswordController">

    <VBox maxWidth="380" spacing="14"
          style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:26;
                 -fx-border-color:#e2e8f0;-fx-border-radius:16;
                 -fx-effect:dropshadow(gaussian,rgba(15,23,42,.12),24,0,0,8);">

        <VBox spacing="4">
            <Label text="Change Password"
                   style="-fx-font-size:19px;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
            <Label text="Enter your current password, then choose a new one."
                   style="-fx-font-size:12px;-fx-text-fill:#64748b;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="CURRENT PASSWORD"
                   style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
            <PasswordField fx:id="txtOldPassword" prefHeight="42"
                           promptText="Current password"
                           style="-fx-background-color:white;-fx-background-radius:10;
                                  -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                  -fx-font-size:13px;-fx-padding:0 14;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="NEW PASSWORD"
                   style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
            <PasswordField fx:id="txtNewPassword" prefHeight="42"
                           promptText="At least 6 characters"
                           style="-fx-background-color:white;-fx-background-radius:10;
                                  -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                  -fx-font-size:13px;-fx-padding:0 14;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="CONFIRM NEW PASSWORD"
                   style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
            <PasswordField fx:id="txtConfirmPassword" prefHeight="42"
                           promptText="Re-enter new password"
                           style="-fx-background-color:white;-fx-background-radius:10;
                                  -fx-border-color:#dbe1ea;-fx-border-radius:10;
                                  -fx-font-size:13px;-fx-padding:0 14;"/>
        </VBox>

        <Label fx:id="lblMessage" wrapText="true"
               style="-fx-font-size:12px;-fx-text-fill:#dc2626;"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancel" onAction="#handleCancel"
                    style="-fx-background-color:#f1f5f9;-fx-text-fill:#334155;
                           -fx-background-radius:10;-fx-font-size:13px;
                           -fx-font-weight:bold;-fx-cursor:hand;-fx-padding:10 18;"/>
            <Button text="SAVE" onAction="#handleSave"
                    defaultButton="true"
                    style="-fx-background-color:#4f46e5;-fx-text-fill:white;
                           -fx-background-radius:10;-fx-font-size:13px;
                           -fx-font-weight:bold;-fx-cursor:hand;-fx-padding:10 22;"/>
        </HBox>
    </VBox>
</StackPane>
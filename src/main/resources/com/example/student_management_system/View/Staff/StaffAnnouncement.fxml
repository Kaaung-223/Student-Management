<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.student_management_system.Controller.Staff.StaffAnnouncementsController"
           style="-fx-background-color:#f6f8fc;">

    <AnchorPane>
        <VBox spacing="16"
              AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="Announcements"
                           style="-fx-text-fill:#0f172a;-fx-font-size:28px;-fx-font-weight:bold;"/>
                    <Label text="Notices and updates from the administration."
                           style="-fx-text-fill:#64748b;-fx-font-size:13px;"/>
                </VBox>
                <Label fx:id="lblAnnouncementCount" text="0 announcements"
                       style="-fx-text-fill:#4f46e5;-fx-background-color:#eef2ff;
                              -fx-background-radius:12;-fx-padding:8 12;
                              -fx-font-size:11px;-fx-font-weight:bold;"/>
            </HBox>

            <!-- SEARCH BAR -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:14;
                         -fx-border-color:#e8edf5;-fx-border-radius:16;">

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="SEARCH"
                           style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtSearch" prefHeight="36"
                               promptText="Search by title or content"/>
                </VBox>

                <VBox spacing="4">
                    <Label text=" " style="-fx-font-size:10px;"/>
                    <Button onAction="#refresh" minHeight="36" minWidth="110"
                            style="-fx-background-color:#4f46e5;-fx-text-fill:white;
                                   -fx-background-radius:9;-fx-font-size:11px;-fx-font-weight:bold;
                                   -fx-padding:0 18;-fx-cursor:hand;"
                            text="Refresh"/>
                </VBox>
            </HBox>

            <!-- MAIN -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">

                <!-- LEFT: LIST -->
                <VBox spacing="12" HBox.hgrow="ALWAYS" prefWidth="480"
                      style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:18;
                             -fx-border-color:#e8edf5;-fx-border-radius:18;">

                    <VBox spacing="3">
                        <Label text="Latest Announcements"
                               style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>
                        <Label text="Select one to read the full message."
                               style="-fx-text-fill:#94a3b8;-fx-font-size:11px;"/>
                    </VBox>

                    <ListView fx:id="announcementList"
                              VBox.vgrow="ALWAYS" prefHeight="520"
                              style="-fx-background-color:white;
                                     -fx-border-color:#e2e8f0;
                                     -fx-border-radius:10;
                                     -fx-background-radius:10;"/>
                </VBox>

                <!-- RIGHT: DETAILS -->
                <VBox minWidth="360" prefWidth="420" spacing="14">

                    <!-- Header card -->
                    <VBox spacing="10"
                          style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:22;
                                 -fx-border-color:#e8edf5;-fx-border-radius:18;">

                        <StackPane minHeight="46" minWidth="46" maxHeight="46" maxWidth="46"
                                   style="-fx-background-color:#eef2ff;-fx-background-radius:12;">
                            <Label text="i"
                                   style="-fx-text-fill:#4f46e5;-fx-font-size:20px;-fx-font-weight:bold;"/>
                        </StackPane>

                        <Label fx:id="lblTitle" text="No announcement selected"
                               wrapText="true"
                               style="-fx-text-fill:#0f172a;-fx-font-size:18px;-fx-font-weight:bold;"/>

                        <Label fx:id="lblMeta" text="Select an announcement to view details"
                               wrapText="true"
                               style="-fx-text-fill:#64748b;-fx-font-size:11px;"/>

                        <Region minHeight="1" style="-fx-background-color:#eef2ff;"/>

                        <Label fx:id="lblAudience" text="Audience: --"
                               style="-fx-text-fill:#4f46e5;-fx-font-size:12px;-fx-font-weight:bold;"/>
                        <Label fx:id="lblPostedBy" text="Posted by: --"
                               style="-fx-text-fill:#334155;-fx-font-size:12px;"/>
                    </VBox>

                    <!-- Message card -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:white;-fx-background-radius:18;-fx-padding:18;
                                 -fx-border-color:#e8edf5;-fx-border-radius:18;">

                        <Label text="MESSAGE"
                               style="-fx-text-fill:#64748b;-fx-font-size:10px;-fx-font-weight:bold;"/>

                        <TextArea fx:id="txtReason" editable="false" wrapText="true"
                                  VBox.vgrow="ALWAYS"
                                  style="-fx-background-color:#f8fafc;-fx-border-color:#e2e8f0;
                                         -fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </AnchorPane>
</StackPane>
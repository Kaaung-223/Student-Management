<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane minHeight="650" minWidth="1000" style="-fx-background-color:#f6f8fc;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.student_management_system.Controller.Staff.StaffDashboardController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox maxWidth="260" minWidth="235" prefWidth="250"
              style="-fx-background-color:linear-gradient(to bottom,#111827,#1e293b);">
            <padding><Insets bottom="20" left="16" right="16" top="25"/></padding>

            <HBox spacing="12" style="-fx-padding:0 4 25 4;">
                <StackPane minHeight="43" minWidth="43"
                           style="-fx-background-color:#4f46e5; -fx-background-radius:13; -fx-effect:dropshadow(gaussian,rgba(79,70,229,.35),12,0,0,3);">
                    <Label style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;" text="S"/>
                </StackPane>
                <VBox spacing="2">
                    <Label style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;" text="StaffHub"/>
                    <Label style="-fx-text-fill:#94a3b8; -fx-font-size:9px; -fx-font-weight:bold;" text="MANAGEMENT SYSTEM"/>
                </VBox>
            </HBox>

            <Label style="-fx-text-fill:#64748b; -fx-font-size:10px; -fx-font-weight:bold; -fx-padding:2 8 8 8;" text="MAIN MENU"/>

            <VBox spacing="5">
                <Button fx:id="btnDashboard" maxWidth="Infinity" minHeight="44" onAction="#refreshDashboard"
                        style="-fx-background-color:#4f46e5; -fx-background-radius:10; -fx-text-fill:white; -fx-font-size:13px; -fx-font-weight:bold; -fx-alignment:CENTER_LEFT; -fx-padding:0 16; -fx-cursor:hand;" text="Dashboard"/>
                <Button fx:id="btnStudents" maxWidth="Infinity" minHeight="44" onAction="#openStudents"
                        style="-fx-background-color:transparent; -fx-text-fill:#cbd5e1; -fx-font-size:13px; -fx-alignment:CENTER_LEFT; -fx-padding:0 16; -fx-cursor:hand;" text="Students"/>
                <Button fx:id="btnPayments" maxWidth="Infinity" minHeight="44" onAction="#openPayments"
                        style="-fx-background-color:transparent; -fx-text-fill:#cbd5e1; -fx-font-size:13px; -fx-alignment:CENTER_LEFT; -fx-padding:0 16; -fx-cursor:hand;" text="Payments"/>
                <Button fx:id="btnLeaveRequests" maxWidth="Infinity" minHeight="44" onAction="#openLeaveRequests"
                        style="-fx-background-color:transparent; -fx-text-fill:#cbd5e1; -fx-font-size:13px; -fx-alignment:CENTER_LEFT; -fx-padding:0 16; -fx-cursor:hand;" text="Leave Requests"/>
                <Button fx:id="btnAnnouncements" maxWidth="Infinity" minHeight="44" onAction="#openAnnouncements"
                        style="-fx-background-color:transparent; -fx-text-fill:#cbd5e1; -fx-font-size:13px; -fx-alignment:CENTER_LEFT; -fx-padding:0 16; -fx-cursor:hand;" text="Announcements"/>
                <Button fx:id="btnProfile" maxWidth="Infinity" minHeight="44" onAction="#openProfile"
                        style="-fx-background-color:transparent; -fx-text-fill:#cbd5e1; -fx-font-size:13px; -fx-alignment:CENTER_LEFT; -fx-padding:0 16; -fx-cursor:hand;" text="Profile"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnLogout" maxWidth="Infinity" minHeight="44" onAction="#logout"
                    style="-fx-background-color:#312e3f; -fx-text-fill:#fda4af; -fx-background-radius:10; -fx-cursor:hand; -fx-font-weight:bold;" text="Logout"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <StackPane fx:id="contentPane">
            <ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background:#f6f8fc; -fx-border-color:transparent;">
                <content>
                    <VBox spacing="24" style="-fx-background-color:#f6f8fc;">
                        <padding><Insets bottom="35" left="34" right="34" top="30"/></padding>

                        <!-- HEADER -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Region minHeight="34" minWidth="6"
                                            style="-fx-background-color:linear-gradient(to bottom,#4f46e5,#6366f1); -fx-background-radius:8;"/>
                                    <VBox spacing="3">
                                        <Label style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;" text="Dashboard"/>
                                        <Label style="-fx-text-fill:#64748b; -fx-font-size:13px;" text="Payments, students, and requests at a glance"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="12"
                                  style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:10 16; -fx-border-color:#e9edf5; -fx-border-radius:14; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),12,0,0,3);">
                                <StackPane minHeight="38" minWidth="38" prefHeight="38" prefWidth="38">
                                    <Circle radius="19" fill="#eef2ff"/>
                                    <ImageView fx:id="staffPhoto" fitHeight="38" fitWidth="38" preserveRatio="false">
                                        <clip><Circle radius="19" centerX="19" centerY="19"/></clip>
                                    </ImageView>
                                </StackPane>
                                <VBox spacing="1">
                                    <Label style="-fx-text-fill:#94a3b8; -fx-font-size:9px; -fx-font-weight:bold;" text="STAFF"/>
                                    <Label fx:id="lblStaffName" style="-fx-text-fill:#1e293b; -fx-font-size:13px; -fx-font-weight:bold;" text="Staff Member"/>
                                </VBox>
                            </HBox>
                        </HBox>

                        <!-- STAT CARDS -->
                        <GridPane hgap="18">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>

                            <VBox spacing="12"
                                  style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:18; -fx-border-color:#e9edf5; -fx-border-radius:18; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40" style="-fx-background-color:#eef2ff; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#6366f1; -fx-font-size:14px; -fx-font-weight:bold;" text="ST"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#6366f1; -fx-font-size:10px; -fx-font-weight:bold;" text="TOTAL STUDENTS"/>
                                </HBox>
                                <Label fx:id="lblTotalStudents" style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;" text="0"/>
                                <Region minHeight="4" style="-fx-background-color:linear-gradient(to right,#6366f1,#a5b4fc); -fx-background-radius:4;"/>
                            </VBox>

                            <VBox spacing="12"
                                  style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:18; -fx-border-color:#e9edf5; -fx-border-radius:18; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40" style="-fx-background-color:#ecfeff; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#0891b2; -fx-font-size:14px; -fx-font-weight:bold;" text="CL"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#0891b2; -fx-font-size:10px; -fx-font-weight:bold;" text="TOTAL CLASSES"/>
                                </HBox>
                                <Label fx:id="lblTotalClasses" style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;" text="0"/>
                                <Region minHeight="4" style="-fx-background-color:linear-gradient(to right,#0891b2,#67e8f9); -fx-background-radius:4;"/>
                            </VBox>

                            <VBox spacing="12"
                                  style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:18; -fx-border-color:#e9edf5; -fx-border-radius:18; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="2">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40" style="-fx-background-color:#f0fdf4; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#16a34a; -fx-font-size:14px; -fx-font-weight:bold;" text="MM"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#16a34a; -fx-font-size:10px; -fx-font-weight:bold;" text="COLLECTED (MONTH)"/>
                                </HBox>
                                <Label fx:id="lblCollectedThisMonth" style="-fx-text-fill:#0f172a; -fx-font-size:24px; -fx-font-weight:bold;" text="0 MMK"/>
                                <Region minHeight="4" style="-fx-background-color:linear-gradient(to right,#16a34a,#86efac); -fx-background-radius:4;"/>
                            </VBox>

                            <VBox spacing="12"
                                  style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:18; -fx-border-color:#e9edf5; -fx-border-radius:18; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="3">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane minHeight="40" minWidth="40" style="-fx-background-color:#fff7ed; -fx-background-radius:12;">
                                        <Label style="-fx-text-fill:#ea580c; -fx-font-size:14px; -fx-font-weight:bold;" text="LR"/>
                                    </StackPane>
                                    <Label style="-fx-text-fill:#ea580c; -fx-font-size:10px; -fx-font-weight:bold;" text="PENDING LEAVE"/>
                                </HBox>
                                <Label fx:id="lblPendingLeaves" style="-fx-text-fill:#0f172a; -fx-font-size:30px; -fx-font-weight:bold;" text="0"/>
                                <Region minHeight="4" style="-fx-background-color:linear-gradient(to right,#ea580c,#fdba74); -fx-background-radius:4;"/>
                            </VBox>

                            <rowConstraints><RowConstraints/></rowConstraints>
                        </GridPane>

                        <!-- CHARTS -->
                        <GridPane hgap="20">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="14"
                                  style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:22; -fx-border-color:#e9edf5; -fx-border-radius:18; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="0">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;" text="Fee Collection Status"/>
                                        <Label style="-fx-text-fill:#94a3b8; -fx-font-size:11px;" text="Active students: fully paid vs partially/unpaid"/>
                                    </VBox>
                                    <Region minHeight="28" minWidth="5" style="-fx-background-color:#4f46e5; -fx-background-radius:4;"/>
                                </HBox>
                                <PieChart fx:id="feePieChart" legendVisible="false" minHeight="220" prefHeight="220" VBox.vgrow="ALWAYS"/>
                                <HBox spacing="12" style="-fx-background-color:#f8fafc; -fx-background-radius:12; -fx-padding:12;">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill:#16a34a; -fx-font-size:10px; -fx-font-weight:bold;" text="PAID"/>
                                        <Label fx:id="lblPaidCount" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#0f172a;" text="0"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill:#ef4444; -fx-font-size:10px; -fx-font-weight:bold;" text="UNPAID"/>
                                        <Label fx:id="lblUnpaidCount" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#0f172a;" text="0"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill:#4f46e5; -fx-font-size:10px; -fx-font-weight:bold;" text="ALL-TIME"/>
                                        <Label fx:id="lblTotalCollected" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#0f172a;" text="0 MMK"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="14"
                                  style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:22; -fx-border-color:#e9edf5; -fx-border-radius:18; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.05),14,0,0,3);"
                                  GridPane.columnIndex="1">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill:#0f172a; -fx-font-size:18px; -fx-font-weight:bold;" text="Payment Methods"/>
                                        <Label style="-fx-text-fill:#94a3b8; -fx-font-size:11px;" text="Last 90 days — how students paid"/>
                                    </VBox>
                                    <Region minHeight="28" minWidth="5" style="-fx-background-color:#8b5cf6; -fx-background-radius:4;"/>
                                </HBox>
                                <PieChart fx:id="methodPieChart" legendVisible="true" minHeight="220" prefHeight="220" VBox.vgrow="ALWAYS"/>
                            </VBox>

                            <rowConstraints><RowConstraints/></rowConstraints>
                        </GridPane>

                    </VBox>
                </content>
            </ScrollPane>

            <AnchorPane fx:id="staffPane" visible="false"/>

            <!-- WELCOME TOAST -->
            <VBox fx:id="welcomeToast" managed="false" maxWidth="420" prefWidth="420" spacing="8"
                  style="-fx-background-color:white; -fx-background-radius:15; -fx-padding:15 17 15 15; -fx-border-color:#e2e8f0; -fx-border-radius:15; -fx-effect:dropshadow(gaussian,rgba(15,23,42,.20),22,0,0,6);"
                  translateX="-24" translateY="24" visible="false" StackPane.alignment="TOP_RIGHT">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane minHeight="38" minWidth="38" style="-fx-background-color:#dcfce7; -fx-background-radius:19;">
                        <Label style="-fx-text-fill:#16a34a; -fx-font-size:17px; -fx-font-weight:bold;" text="✓"/>
                    </StackPane>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblToastTitle" style="-fx-text-fill:#64748b; -fx-font-size:9px; -fx-font-weight:bold;" text="LOGIN SUCCESSFUL"/>
                        <Label fx:id="lblToastHeading" style="-fx-text-fill:#0f172a; -fx-font-size:14px; -fx-font-weight:bold;" text="Welcome back!"/>
                        <Label fx:id="lblDashboardWelcome" style="-fx-text-fill:#64748b; -fx-font-size:11px;" text="You are signed in successfully." wrapText="true"/>
                    </VBox>
                </HBox>
                <Region maxHeight="3" minHeight="3" style="-fx-background-color:#22c55e; -fx-background-radius:3;"/>
            </VBox>

            <!-- ✅ NEW: ANNOUNCEMENT TOAST (shown after the welcome toast, if any unread) -->
            <VBox fx:id="announcementToast" managed="false" visible="false"
                  maxWidth="420" prefWidth="420" spacing="8"
                  translateX="-24" translateY="24"
                  StackPane.alignment="TOP_RIGHT"
                  style="-fx-background-color:white; -fx-background-radius:15;
                         -fx-padding:15 17 15 15;
                         -fx-border-color:#e2e8f0; -fx-border-radius:15;
                         -fx-effect:dropshadow(gaussian,rgba(15,23,42,.20),22,0,0,6);">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="toast-icon" minHeight="38" minWidth="38"
                               style="-fx-background-color:#fef3c7; -fx-background-radius:19;">
                        <Label styleClass="toast-icon-label" text="!"
                               style="-fx-text-fill:#d97706; -fx-font-size:17px; -fx-font-weight:bold;"/>
                    </StackPane>

                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblAnnToastTitle"
                               text="NEW ANNOUNCEMENT"
                               style="-fx-text-fill:#64748b; -fx-font-size:9px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblAnnToastHeading"
                               text="You have new announcements"
                               style="-fx-text-fill:#0f172a; -fx-font-size:14px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblAnnToastMessage"
                               text="Open the Announcements page to read them."
                               wrapText="true"
                               style="-fx-text-fill:#64748b; -fx-font-size:11px;"/>
                    </VBox>
                </HBox>

                <Region styleClass="toast-bar" maxHeight="3" minHeight="3"
                        style="-fx-background-color:#f59e0b; -fx-background-radius:3;"/>
            </VBox>

        </StackPane>
    </center>
</BorderPane>